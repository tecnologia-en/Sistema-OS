+// Enfoque OS 0.2.26: subtle orange attention pulse for URGENT X11 windows.
+// This is an event-driven indicator, not a blink for every content change.
+// While the group is focused or there is no URGENT window, all timers stop.
+void Group::refreshAttention()
+{
+	bool needsAttention = false;
+	if (!mActive)
+	{
+		mWindows.findIf([&needsAttention](GroupWindow* window) -> bool {
+			if (window->getState(XFW_WINDOW_STATE_URGENT))
+			{
+				needsAttention = true;
+				return true;
+			}
+			return false;
+		});
+	}
+	if (!needsAttention)
+	{
+		if (mAttentionTimerId != 0)
+		{
+			g_source_remove(mAttentionTimerId);
+			mAttentionTimerId = 0;
+		}
+		mAttentionOn = false;
+		Help::Gtk::cssClassRemove(mButton, "enfoque_attention");
+		return;
+	}
+	if (mAttentionTimerId == 0)
+	{
+		mAttentionOn = true;
+		Help::Gtk::cssClassAdd(mButton, "enfoque_attention");
+		mAttentionTimerId = g_timeout_add(900, +[](gpointer context) -> gboolean {
+			Group* group = static_cast<Group*>(context);
+			group->mAttentionOn = !group->mAttentionOn;
+			if (group->mAttentionOn)
+				Help::Gtk::cssClassAdd(group->mButton, "enfoque_attention");
+			else
+				Help::Gtk::cssClassRemove(group->mButton, "enfoque_attention");
+			return G_SOURCE_CONTINUE;
+		}, this);
+	}
+}
+
 void Group::onWindowActivate(GroupWindow* groupWindow)
 {
 	mActive = true;
+	refreshAttention();
 	setTopWindow(groupWindow);
 	Help::Gtk::cssClassAdd(mButton, "active_group");
 }
