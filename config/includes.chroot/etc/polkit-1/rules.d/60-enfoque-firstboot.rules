// Regra estrita: somente primeiro cadastro, usuario administrativo local ativo.
// Nao autoriza outros programas, outras acoes polkit ou acesso remoto por si.
polkit.addRule(function(action, subject) {
    if (action.id === "org.enfoque.os.firstboot.apply" &&
        subject.local && subject.active && subject.isInGroup("sudo")) {
        return polkit.Result.YES;
    }
});
