# Rotate verbose diagnostic logs only; NEVER rotate or delete payment receipts,
# PGWebLib/Data/*.pos, PayGo.db, transaction state, or backup/reference data.
/var/lib/paygo-tef/runtime/drive_c/ProgramData/PayGo/Log/*.txt
/var/lib/paygo-tef/runtime/drive_c/ProgramData/PayGo/PGWebLib/Log/*.log
{
    su enfoque-tef enfoque-tef
    daily
    rotate 14
    maxsize 10M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    dateext
    create 0600 enfoque-tef enfoque-tef
}
