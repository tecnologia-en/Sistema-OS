[Unit]
Description=Enfoque OS - aplicar atualizacoes autorizadas pela TI
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/run/live/medium
ConditionPathExists=/etc/enfoque-update/auto.enabled

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/enfoque-update apply --automatic
TimeoutStartSec=7200
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
