[Unit]
Description=Enfoque OS - Captura remota de laboratorio autenticada
Wants=network-online.target
After=network-online.target lightdm.service
ConditionPathExists=/etc/enfoque-os/agent.json

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /usr/local/bin/enfoque-captura-tela
Restart=on-failure
RestartSec=8
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
CapabilityBoundingSet=
MemoryMax=180M

[Install]
WantedBy=multi-user.target
