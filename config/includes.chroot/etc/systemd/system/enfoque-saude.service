[Unit]
Description=Enfoque OS - verificar discos SMART, memoria e espaco
ConditionPathExists=!/run/live/medium
ConditionVirtualization=!container

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/enfoque-saude
TimeoutStartSec=100
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
StateDirectory=enfoque-os
StateDirectoryMode=0755
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/enfoque-os
PrivateTmp=true
UMask=0022
