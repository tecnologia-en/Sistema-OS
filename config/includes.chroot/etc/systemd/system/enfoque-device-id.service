[Unit]
Description=Enfoque OS - gerar ID unico do equipamento no primeiro boot
After=local-fs.target
Before=graphical.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/bin/enfoque-id --init
RemainAfterExit=yes
StateDirectory=enfoque-os
StateDirectoryMode=0755
RuntimeDirectory=enfoque-os
RuntimeDirectoryMode=0755
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/enfoque-os /run/enfoque-os

[Install]
WantedBy=multi-user.target
