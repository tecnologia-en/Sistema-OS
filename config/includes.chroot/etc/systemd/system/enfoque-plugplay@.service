[Unit]
Description=Enfoque OS - plug and play USB %I
After=systemd-udevd.service local-fs.target
ConditionPathExists=!/run/live/medium
ConditionVirtualization=!container

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/enfoque-plugplay --usb %I
TimeoutStartSec=240
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_SYS_MODULE CAP_DAC_OVERRIDE CAP_FOWNER CAP_CHOWN CAP_SETUID CAP_SETGID
UMask=0027
