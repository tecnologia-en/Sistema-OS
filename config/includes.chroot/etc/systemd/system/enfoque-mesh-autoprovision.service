[Unit]
Description=Enfoque OS - provisionar MeshCentral somente apos aprovacao da TI
Wants=network-online.target
After=network-online.target enfoque-device-id.service
Requires=enfoque-device-id.service
ConditionPathExists=/etc/enfoque-os/agent.json

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /usr/local/bin/enfoque-mesh-autoprovision
Restart=on-failure
RestartSec=90
StartLimitIntervalSec=0
TimeoutStartSec=240
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=false
UMask=0077

[Install]
WantedBy=multi-user.target
