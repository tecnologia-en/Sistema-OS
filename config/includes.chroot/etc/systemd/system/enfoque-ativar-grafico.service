[Unit]
Description=Enfoque OS - Exibir sessao grafica XFCE no boot Live
Documentation=https://github.com/tecnologia-en/Sistema-OS
After=lightdm.service
Requires=lightdm.service
ConditionPathExists=/run/live/medium
# VT switching is exclusively a VirtualBox framebuffer workaround.
# On physical computers it can blank the screen and is unnecessary.
ConditionVirtualization=oracle

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/enfoque-ativar-grafico
TimeoutStartSec=60
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=graphical.target
