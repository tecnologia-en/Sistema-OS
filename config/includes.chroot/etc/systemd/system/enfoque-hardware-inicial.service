[Unit]
Description=Enfoque OS - detecção automática de vídeo e impressoras
Wants=network-online.target cups.service
After=network-online.target cups.service
ConditionPathExists=!/run/live/medium
ConditionVirtualization=!container

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/enfoque-hardware-setup
TimeoutStartSec=900
Nice=10
IOSchedulingClass=idle
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
