[Unit]
Description=Enfoque OS - solicitar e validar cadastro automatico da TI
Wants=network-online.target
After=network-online.target enfoque-device-id.service
Requires=enfoque-device-id.service
ConditionPathExists=/var/lib/enfoque-os/firstboot.json
ConditionPathExists=!/run/live/medium

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/enfoque-zero-touch once
TimeoutStartSec=150
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
