[Desktop Entry]
Type=Application
Name=Enfoque OS - Protecao de tela
Comment=Mostra tela de bloqueio com relogio apos 3 minutos e solicita senha apos 15
Exec=/usr/local/bin/enfoque-proteger-tela
TryExec=/usr/local/bin/enfoque-proteger-tela
OnlyShowIn=XFCE;
NoDisplay=true
X-GNOME-Autostart-enabled=true
