<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="org.enfoque.os.firstboot.apply">
    <description>Configurar o nome e a loja do computador Enfoque OS</description>
    <message>Autorizacao para finalizar o primeiro acesso deste equipamento</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/enfoque-firstboot-apply</annotate>
  </action>
</policyconfig>
