{
  "manifest_version": 3,
  "name": "Enfoque TEF N960K - Caixa 1 - Teste Desktop",
  "version": "1.7.8.36",
  "description": "N960K: imprimir via do cliente somente apos venda concluida; Cancelar/Voltar e recuperacao por falha USB preservados.",
  "key": "",
  "permissions": [
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://enfoquepapelaria.meusige.com.br/*",
    "http://127.0.0.1:8879/*",
    "http://127.0.0.1:8878/*"
  ],
  "background": {
    "service_worker": "n960k-discovery-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://enfoquepapelaria.meusige.com.br/*"
      ],
      "js": [
        "n960k-logic.js",
        "n960k-pdv.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://enfoquepapelaria.meusige.com.br/*"
      ],
      "js": [
        "n960k-discovery-watch.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "TEF N960K - Piloto Desktop (independente)"
  }
}
