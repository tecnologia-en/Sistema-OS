#!/usr/bin/python3
"""Apply 0.2.43 XFCE screen policy in a logged-in session after .deb upgrade.

Only settings are applied. Does NOT change desktop window, simulate input,
lock/unlock the PC, switch users, or restart the browser.
"""
import os
import pwd
import subprocess
import sys


def run(argv, timeout=8, env=None):
    return subprocess.run(argv, capture_output=True, text=True,
                          timeout=timeout, env=env, check=False)


def active_graphical_sessions():
    try:
        records = run(["/usr/bin/loginctl", "list-sessions", "--no-legend"], 7).stdout
    except (OSError, subprocess.TimeoutExpired):
        return []
    active = []
    found = set()
    for row in records.splitlines():
        fields = row.split()
        if len(fields) < 3 or not fields[0].isdigit() or not fields[1].isdigit():
            continue
        sid, uid, user = fields[:3]
        uid = int(uid)
        if uid < 1000 or user in ("enfoque-ti", "enfoque-kiosk") or uid in found:
            continue
        try:
            show = run(["/usr/bin/loginctl", "show-session", sid,
                        "-p", "Type", "-p", "Active", "-p", "Display"], 8).stdout
            props=dict(x.split("=",1) for x in show.splitlines() if "=" in x)
            passwd=pwd.getpwnam(user)
            if props.get("Type") != "x11" or props.get("Active") != "yes":
                continue
            display = props.get("Display") or ":0"
            if not display.startswith(":") or len(display)>12:
                continue
            active.append((uid,user,passwd.pw_dir,display))
            found.add(uid)
        except (OSError,KeyError,subprocess.TimeoutExpired):
            continue
    return active


def main():
    if os.geteuid()!=0 or os.path.exists("/run/live/medium"):
        return 0
    for uid,user,home,display in active_graphical_sessions():
        env={
            "HOME":home,"USER":user,"LOGNAME":user,
            "DISPLAY":display,"XAUTHORITY":home+"/.Xauthority",
            "XDG_CURRENT_DESKTOP":"XFCE",
            "XDG_RUNTIME_DIR":f"/run/user/{uid}",
            "DBUS_SESSION_BUS_ADDRESS":f"unix:path=/run/user/{uid}/bus",
            "PATH":"/usr/local/bin:/usr/bin:/bin",
        }
        try:
            command=["/usr/sbin/runuser","-u",user,"--",
                     "/usr/bin/env",*[k+"="+v for k,v in env.items()],
                     "/usr/local/bin/enfoque-proteger-tela"]
            run(command,12)
        except (OSError,subprocess.TimeoutExpired):
            continue
        # Starts the lightweight X11 watchdog in the existing session only.
        # Not a desktop/UI operation; it silently maintains power settings.
        try:
            subprocess.Popen(["/usr/sbin/runuser","-u",user,"--",
                "/usr/bin/env",*[k+"="+v for k,v in env.items()],
                "/usr/local/bin/enfoque-screensaver-watchdog"],
                stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,start_new_session=True)
        except OSError:
            pass
    return 0


if __name__=="__main__":
    sys.exit(main())
