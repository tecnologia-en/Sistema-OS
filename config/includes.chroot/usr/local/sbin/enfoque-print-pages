#!/usr/bin/env python3
"""Enfoque OS real-time CUPS page counter, without document/user data.

Reads only page_log generated by the LOCAL CUPS scheduler. Every accounted
page/copy becomes a numeric event with a timestamp, stored in a durable local
SQLite queue and authenticated with this PC's approved Zero Touch credentials.
A delivery retry cannot double-count on the server.
"""
import argparse
import datetime
import hashlib
import json
import os
from pathlib import Path
import re
import sqlite3
import stat
import time
import urllib.request
from urllib.error import HTTPError, URLError
import uuid

PAGE_LOG=Path("/var/log/cups/page_log")
DB_FILE=Path("/var/lib/enfoque-os/print-telemetry/events.sqlite3")
IDENTITY=Path("/var/lib/enfoque-os/device-identity.json")
PROFILE=Path("/var/lib/enfoque-os/firstboot.json")
AGENT=Path("/etc/enfoque-os/agent.json")
LIVE=Path("/run/live/medium")
ENDPOINT="https://intranet.enfoquepapelaria.com.br/api/remote-access/agent/print-pages"
UUID4=re.compile(r"^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$")
TOKEN=re.compile(r"^[A-Za-z0-9_-]{40,150}$")
LOG=re.compile(r"^(\S+)\s+\S+\s+([0-9]+)\s+\[([^\]]+)\]\s+(\S+)\s+([0-9]+)\s*$")
MONTH={name.lower():idx for idx,name in enumerate(
  ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"],1)}
DB_SCHEMA="""
CREATE TABLE IF NOT EXISTS cursor(
 key TEXT PRIMARY KEY, device INTEGER NOT NULL, inode INTEGER NOT NULL,
 generation INTEGER NOT NULL, offset INTEGER NOT NULL
);
CREATE TABLE IF NOT EXISTS events(
 event_id TEXT PRIMARY KEY,
 pages INTEGER NOT NULL CHECK(pages BETWEEN 1 AND 500),
 occurred_at TEXT NOT NULL,
 delivered INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX IF NOT EXISTS ix_print_unsent ON events(delivered,occurred_at);
"""

def safe_profile(path):
    if path.is_symlink() or not path.is_file() or path.stat().st_uid!=0:
        raise ValueError("Perfil nao confiavel")
    if path.stat().st_mode & 0o022:raise ValueError("Identidade modificavel por outros")
    return json.loads(path.read_text(encoding="utf8"))

def machine_uuid():
    if LIVE.exists():raise RuntimeError("Nao executar no modo Live")
    device=safe_profile(IDENTITY)
    profile=safe_profile(PROFILE)
    value=device.get("uuid")
    if (not isinstance(value,str) or not UUID4.fullmatch(value) or
        profile.get("uuid")!=value or
        profile.get("shortId")!=device.get("shortId")):
        raise ValueError("Cadastro Enfoque OS inconsistente")
    return value

def credentials(local_id):
    if not AGENT.is_file() or AGENT.is_symlink():return None
    meta=AGENT.stat()
    if meta.st_uid!=0 or stat.S_IMODE(meta.st_mode)!=0o600:
        raise ValueError("Credencial do agente insegura")
    obj=json.loads(AGENT.read_text(encoding="utf8"))
    if (obj.get("localUuid")!=local_id or
        not UUID4.fullmatch(str(obj.get("id",""))) or
        not TOKEN.fullmatch(str(obj.get("token","")))):
        raise ValueError("Credencial Zero Touch nao corresponde ao computador")
    return obj

def iso_cups_time(text):
    # CUPS uses English abbreviated months in the Common Log timestamp.
    match=re.fullmatch(r"([0-9]{1,2})/([A-Za-z]{3})/([0-9]{4}):"
      r"([0-9]{2}):([0-9]{2}):([0-9]{2}) ([+-][0-9]{4})",text)
    if not match:raise ValueError("Horario de impressao invalido")
    day,mon,year,hour,minute,second,zone=match.groups()
    month=MONTH.get(mon.lower())
    if not month:raise ValueError("Mes de CUPS invalido")
    tz=datetime.timezone(datetime.timedelta(
      minutes=(1 if zone[0]=='+' else -1)*(int(zone[1:3])*60+int(zone[3:]))))
    value=datetime.datetime(int(year),month,int(day),int(hour),int(minute),
      int(second),tzinfo=tz)
    return value.astimezone(datetime.timezone.utc).isoformat(timespec="seconds").replace("+00:00","Z")

def event_from_line(raw,machine,dev,inode,generation,offset,office=None):
    if len(raw)>2048:return None
    match=LOG.fullmatch(raw.strip())
    if not match:return None
    _printer,_job,datetime_field,_page,copies=match.groups()
    if office is not None and not office(_printer):return None
    pages=int(copies)
    if not 1<=pages<=500:return None
    occurred=iso_cups_time(datetime_field)
    identity="|".join(map(str,("cups-page-v1",machine,dev,inode,generation,offset)))
    return {"id":hashlib.sha256(identity.encode("ascii")).hexdigest(),
      "pages":pages,"occurredAt":occurred}

def open_db(db_file=DB_FILE):
    db_file.parent.mkdir(parents=True,exist_ok=True,mode=0o700)
    os.chmod(db_file.parent,0o700)
    prev=os.umask(0o077)
    try:
        db=sqlite3.connect(db_file,timeout=10)
        db.execute("PRAGMA busy_timeout=10000")
        db.executescript(DB_SCHEMA)
        return db
    finally:os.umask(prev)

def scan_pages(db,machine,file=PAGE_LOG,initial_tail=True,max_bytes=2_000_000,office=None):
    try:
        info=file.lstat()
    except FileNotFoundError:
        # Missing log is normal until the first print. Mark the empty starting
        # position so that the first-ever CUPS log line is counted, not skipped.
        if db.execute("SELECT 1 FROM cursor WHERE key='page_log'").fetchone() is None:
            db.execute("INSERT INTO cursor VALUES('page_log',0,0,0,0)")
            db.commit()
        return 0
    if not stat.S_ISREG(info.st_mode) or info.st_mode & 0o002:
        raise PermissionError("CUPS page_log precisa ser arquivo regular confiavel")
    st_dev,st_ino=info.st_dev,info.st_ino
    cursor=db.execute("SELECT device,inode,generation,offset FROM cursor WHERE key='page_log'").fetchone()
    generation=0
    rotated_inserted=0
    if cursor is None:
        # Never upload historic entries left in an existing OS log.
        offset=info.st_size if initial_tail else 0
        db.execute("INSERT INTO cursor VALUES('page_log',?,?,?,?)",
          (st_dev,st_ino,0,offset))
        db.commit()
        return 0
    else:
        old_dev,old_ino,generation,offset=cursor
        if old_dev!=st_dev or old_ino!=st_ino:
            # Capture remaining bytes from the previous inode on rotation,
            # if retained as page_log.1, before switching to the new file.
            rotated=file.with_name(file.name+".1")
            try:
                rotated_stat=rotated.stat()
                if (rotated_stat.st_dev==old_dev and rotated_stat.st_ino==old_ino and
                     rotated_stat.st_size>offset):
                    rotated_inserted=_process_file(db,rotated,machine,old_dev,old_ino,
                                  generation,offset,rotated_stat.st_size-offset,False,office)
            except (FileNotFoundError,OSError):pass
            generation+=1
            offset=0
        elif info.st_size<offset:
            generation+=1
            offset=0  # copytruncate
    return rotated_inserted+_process_file(db,file,machine,st_dev,st_ino,
                                  generation,offset,max_bytes,True,office)

def _process_file(db,file,machine,dev,inode,generation,offset,max_bytes,update_cursor,office=None):
    inserted=0
    with open(file,"rb") as stream:
        stream.seek(offset)
        read_size=0
        while read_size < max_bytes:
            pos=stream.tell()
            line=stream.readline(2049)
            if not line:break
            if len(line)>2048 and not line.endswith(b"\n"):
                # Drop unsafe oversize lines, never transmit their contents.
                stream.readline()
                continue
            if not line.endswith(b"\n"):
                stream.seek(pos)
                break
            read_size+=len(line)
            try:entry=event_from_line(line.decode("utf8"),machine,dev,inode,generation,pos,office)
            except (UnicodeDecodeError,ValueError):entry=None
            if entry:
                inserted+=db.execute("INSERT OR IGNORE INTO events(event_id,pages,occurred_at) VALUES(?,?,?)",
                  (entry["id"],entry["pages"],entry["occurredAt"])).rowcount
        at=stream.tell()
    if update_cursor:
        db.execute("""INSERT INTO cursor(key,device,inode,generation,offset)
          VALUES('page_log',?,?,?,?)
          ON CONFLICT(key) DO UPDATE SET device=excluded.device,inode=excluded.inode,
             generation=excluded.generation,offset=excluded.offset""",
          (dev,inode,generation,at))
    db.commit()
    return inserted

def pending(db,limit=64):
    rows=db.execute("SELECT event_id,pages,occurred_at FROM events WHERE delivered=0 ORDER BY occurred_at,event_id LIMIT ?",(limit,)).fetchall()
    return [{"id":row[0],"pages":row[1],"occurredAt":row[2]} for row in rows]

def send_events(db,machine,auth,transport=None):
    if auth is None:return 0
    events=pending(db)
    if not events:return 0
    data=json.dumps({"deviceUuid":machine,"events":events},separators=(",",":")).encode("utf8")
    req=urllib.request.Request(ENDPOINT,data,
      {"Content-Type":"application/json","X-Enfoque-Device-Id":auth["id"],
       "X-Enfoque-Device-Token":auth["token"],"User-Agent":"Enfoque-OS-print-pages/0.2.48"},
      method="POST")
    conn=transport or urllib.request.urlopen
    with conn(req,timeout=9) as response:
        body=response.read(1500)
        if response.status!=200:raise RuntimeError("Servidor rejeitou o lote")
    ack=json.loads(body)
    if ack.get("ok") is not True or ack.get("accepted")!=len(events):
        raise RuntimeError("Confirmacao incompleta")
    db.executemany("UPDATE events SET delivered=1 WHERE event_id=?",
      [(entry["id"],) for entry in events])
    db.commit()
    # Retain a bounded local history for offline troubleshooting.
    db.execute("""DELETE FROM events WHERE delivered=1 AND occurred_at <
       datetime('now','-45 days')""")
    db.commit()
    return len(events)

_meter=None
def meter_module():
    global _meter
    if _meter is None:
        import importlib.util
        path=Path(__file__).resolve().parents[1]/"lib/enfoque-printer-meter/collector.py"
        spec=importlib.util.spec_from_file_location("enfoque_printer_meter",path)
        _meter=importlib.util.module_from_spec(spec);spec.loader.exec_module(_meter)
    return _meter

def once(db,machine,auth_loader=credentials):
    meter=meter_module()
    count=scan_pages(db,machine,office=meter.is_office)
    try:meter.tick(db,machine,auth_loader)
    except (OSError,ValueError,RuntimeError):
        print("Contador físico indisponível; fallback CUPS somente de escritório.",flush=True)
    try:sent=send_events(db,machine,auth_loader(machine))
    except (HTTPError,URLError,OSError,ValueError,RuntimeError) as error:
        # Do not print document names, token, or raw payload.
        print("Canfoque impressões: aguardando rede/credencial:",type(error).__name__,flush=True)
        sent=0
    return count,sent

def main():
    parser=argparse.ArgumentParser()
    parser.add_argument("--once",action="store_true")
    parser.add_argument("--loop",action="store_true")
    args=parser.parse_args()
    machine=machine_uuid()
    db=open_db()
    try:
        if args.once:
            once(db,machine)
            return 0
        if not args.loop:
            parser.error("Use --once ou --loop")
        while True:
            once(db,machine)
            time.sleep(2.0)
    finally:db.close()
if __name__=="__main__":
    raise SystemExit(main())
