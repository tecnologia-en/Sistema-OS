#!/bin/sh
# No modo Live, a sessao Xorg pode iniciar em vt7 com o framebuffer ainda preto.
# Forcar uma troca completa de VT, mesmo se fgconsole ja indicar o VT grafico,
# garante que o console recarregue a imagem no VirtualBox.
set -eu
attempt=0
while [ "$attempt" -lt 45 ]; do
  attempt=$((attempt + 1))
  if pgrep -x xfce4-session >/dev/null 2>&1; then
    vt="$(ps -C Xorg -o args= 2>/dev/null | tr ' ' '\n' | sed -nE 's/^vt([0-9]+)$/\1/p' | head -n 1)"
    if [ -n "$vt" ]; then
      case "$vt" in *[!0-9]*) logger -t enfoque-os "VT grafico invalido: $vt"; exit 1 ;; esac
      # A sessao XFCE pode existir antes do primeiro desenho do desktop.
      sleep 2
      current="$(fgconsole 2>/dev/null || true)"
      alternate=1
      if [ "$vt" = "1" ]; then alternate=2; fi
      # chvt <vt> isolado nao repinta quando o kernel ja considera esse VT ativo.
      if [ "$current" != "$alternate" ]; then
        if ! chvt "$alternate"; then
          logger -t enfoque-os "Falha ao ativar VT temporario $alternate antes do grafico vt$vt"
          exit 1
        fi
      fi
      sleep 1
      if chvt "$vt"; then
        logger -t enfoque-os "Sessao XFCE exibida no terminal vt$vt apos atualizar o VT (anterior: ${current:-desconhecido})"
        exit 0
      fi
      logger -t enfoque-os "Falha ao mostrar o terminal grafico vt$vt"
      exit 1
    fi
  fi
  sleep 1
done
logger -t enfoque-os "Sessao grafica nao encontrada apos 45 segundos"
exit 1
