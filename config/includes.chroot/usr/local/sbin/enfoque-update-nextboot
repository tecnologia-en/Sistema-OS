#!/usr/bin/env python3
"""Enfoque OS 0.2.38: root-only scheduled signed APT upgrade on NEXT boot.

No immediate execution upon schedule. A request is bound to the current
kernel boot ID and cannot be consumed in that same boot, even if systemd
starts the service early. On next boot, it creates a verified recovery
archive via enfoque-update before installing the signed .deb. Failures
are recorded and are not retried indefinitely.
"""
import argparse
from datetime import datetime, timezone
import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import tempfile

REQUEST = Path("/var/lib/enfoque-update/nextboot.json")
RESULT = Path("/var/lib/enfoque-update/nextboot-result.json")
LOCK = Path("/run/lock/enfoque-update-nextboot.lock")
BOOT = Path("/proc/sys/kernel/random/boot_id")
RELEASE = Path("/etc/enfoque-os-release")
VERSION = re.compile(r"^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,4}$")


def current():
    match = re.search(r'^VERSION="([^"]+)"$', RELEASE.read_text(), re.MULTILINE)
    if not match or not VERSION.fullmatch(match.group(1)):
        raise RuntimeError("Versao atual invalida")
    return match.group(1)


def tuple_version(v):
    if not VERSION.fullmatch(v):
        raise ValueError("Versao invalida")
    return tuple(map(int, v.split(".")))


def boot_id():
    value = BOOT.read_text().strip()
    if not re.fullmatch(r"[0-9a-f-]{36}", value):
        raise RuntimeError("Identificador do boot indisponivel")
    return value


def root_only():
    if os.geteuid() != 0:
        raise PermissionError("Agendamento exige root autorizado")
    if Path("/run/live/medium").exists():
        raise RuntimeError("Nao agendar na ISO Live")


def read_request(file=None, *, owner_uid=0):
    file = REQUEST if file is None else file
    if not file.exists():
        return None
    meta = file.lstat()
    if file.is_symlink() or not file.is_file() or meta.st_uid != owner_uid or meta.st_mode & 0o077:
        raise PermissionError("Agendamento nao pertence a root")
    data = json.loads(file.read_text())
    if data.get("schema") != 1 or not VERSION.fullmatch(data.get("version", "")) or not re.fullmatch(r"[0-9a-f-]{36}", data.get("createdBoot", "")):
        raise ValueError("Agendamento modificado")
    return data


def atomic(path, data):
    path.parent.mkdir(parents=True, mode=0o700, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=path.parent, prefix=".nextboot-", delete=False, mode="w") as f:
        p = Path(f.name)
        os.chmod(p, 0o600)
        json.dump(data, f, ensure_ascii=False, indent=2)
        f.write("\n")
        f.flush()
        os.fsync(f.fileno())
    os.replace(p, path)


def schedule(version):
    if tuple_version(version) <= tuple_version(current()):
        raise RuntimeError("Versao agendada deve ser superior a versao atual")
    request = {
        "schema": 1, "version": version, "createdBoot": boot_id(),
        "created": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "status": "aguardando-proximo-boot",
    }
    atomic(REQUEST, request)
    return {"ok": True, "scheduled": version, "when": "proximo-boot",
            "message": "O PC baixara pelo repositorio APT assinado apos reiniciar, com recuperacao previa."}


def process(data, now_boot, *, run=subprocess.run):
    if data["createdBoot"] == now_boot:
        return {"ok": True, "executed": False, "reason": "aguardando_reinicio"}
    if tuple_version(data["version"]) <= tuple_version(current()):
        return {"ok": True, "executed": False, "reason": "ja_instalado"}
    proc = run(["/usr/local/sbin/enfoque-update", "apply-core", data["version"]],
               capture_output=True, text=True, check=False,
               stdin=subprocess.DEVNULL, timeout=8300)
    if proc.returncode:
        return {"ok": False, "executed": True, "error": "atualizacao_ou_recuperacao_falhou",
                "exitCode": proc.returncode}
    return {"ok": True, "executed": True, "installed": data["version"]}


def apply():
    request = read_request()
    if not request:
        return {"ok": True, "executed": False, "reason": "sem_agendamento"}
    # Do not mutate or consume the schedule until the next kernel boot.
    if request["createdBoot"] == boot_id():
        return {"ok": True, "executed": False, "reason": "aguardando_reinicio"}
    try:
        result = process(request, boot_id())
    except (OSError, subprocess.SubprocessError) as e:
        result = {"ok": False, "executed": True, "error": type(e).__name__}
    result["checkedAt"] = datetime.now(timezone.utc).isoformat(timespec="seconds")
    result["target"] = request["version"]
    atomic(RESULT, result)
    REQUEST.unlink(missing_ok=True)
    return result


def main():
    p = argparse.ArgumentParser(description="Enfoque OS: atualizar no proximo boot")
    p.add_argument("operation", choices=("schedule", "status", "cancel", "apply"))
    p.add_argument("version", nargs="?")
    a = p.parse_args()
    try:
        root_only()
        LOCK.parent.mkdir(parents=True, exist_ok=True)
        with LOCK.open("a+") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            if a.operation == "schedule":
                if not a.version:
                    raise ValueError("Informe a versao desejada")
                result = schedule(a.version)
                # O timer continua ativo nos proximos boots, mas este boot
                # nunca consome o pedido porque o boot_id e o mesmo.
                subprocess.run(["/usr/bin/systemctl", "enable", "--now",
                                "enfoque-update-nextboot.timer"], check=True,
                               capture_output=True, timeout=25)
            elif a.operation == "status":
                result = {"scheduled": read_request(),
                          "lastResult": json.loads(RESULT.read_text()) if RESULT.is_file() else None}
            elif a.operation == "cancel":
                REQUEST.unlink(missing_ok=True)
                result = {"ok": True, "cancelled": True}
            else:
                result = apply()
        print(json.dumps(result, ensure_ascii=False))
        return 0 if result.get("ok", True) else 2
    except (OSError, ValueError, PermissionError, RuntimeError, subprocess.SubprocessError) as error:
        print(json.dumps({"ok": False, "error": str(error)[:240]}, ensure_ascii=False))
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
