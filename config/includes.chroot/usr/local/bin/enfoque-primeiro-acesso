#!/usr/bin/env python3
"""First login wizard for an installed Enfoque OS computer."""
import importlib.util
import json
import os
from pathlib import Path
import pwd
import subprocess
import sys
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib

LIB = "/usr/local/lib/enfoque-onboarding/identity.py"
spec = importlib.util.spec_from_file_location("enfoque_identity", LIB)
identity = importlib.util.module_from_spec(spec)
spec.loader.exec_module(identity)
sys.path.insert(0, str(Path(LIB).parent))
import firstboot
PROFILE = Path("/var/lib/enfoque-os/firstboot.json")


def running_live():
    return Path("/run/live/medium").exists() or "boot=live" in Path("/proc/cmdline").read_text(errors="replace")


class Onboarding(Gtk.Window):
    def __init__(self, preview=False):
        super().__init__(title="Enfoque OS - Primeiro acesso")
        self.preview = preview
        self.username = pwd.getpwuid(os.getuid()).pw_name
        self.set_default_size(720, 580)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_keep_above(True)
        self.set_modal(True)
        self.connect("delete-event", self.close_event)
        self.connect("destroy", Gtk.main_quit)
        if not preview:
            self.set_decorated(False)
            self.fullscreen()

        wrap = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        wrap.set_halign(Gtk.Align.CENTER)
        wrap.set_valign(Gtk.Align.CENTER)
        wrap.set_size_request(660, -1)
        wrap.set_border_width(28)
        self.add(wrap)
        heading = Gtk.Label()
        heading.set_markup('<span size="xx-large" weight="bold">Configuracao inicial</span>')
        heading.set_xalign(0)
        wrap.pack_start(heading, False, False, 6)
        self.add_label(wrap, "Este computador deve ser identificado antes do primeiro uso.")
        self.add_label(wrap, "Nome do PC (exemplo: CAIXA-ILHA-01)")
        self.pc_name = Gtk.Entry()
        self.pc_name.set_max_length(48)
        self.pc_name.set_placeholder_text("CAIXA-LOJA-01")
        wrap.pack_start(self.pc_name, False, False, 0)
        self.add_label(wrap, "Empresa")
        self.company = Gtk.ComboBoxText()
        self.company.append("", "Selecione uma empresa")
        for key, rec in identity.COMPANIES.items():
            self.company.append(key, rec["name"])
        self.company.set_active_id("")
        self.company.connect("changed", self.company_changed)
        wrap.pack_start(self.company, False, False, 0)
        self.add_label(wrap, "Loja / unidade")
        self.unit = Gtk.ComboBoxText()
        self.unit.append("", "Selecione primeiro a empresa")
        self.unit.set_active_id("")
        wrap.pack_start(self.unit, False, False, 0)
        self.device_short = ""
        self.device = Gtk.Label(label="Identificador: gerado no primeiro boot")
        self.device.set_xalign(0)
        self.device.set_selectable(True)
        wrap.pack_start(self.device, False, False, 8)
        try:
            info = subprocess.run(["/usr/local/bin/enfoque-id", "--json"],
                                  capture_output=True, text=True, timeout=4, check=True)
            code = json.loads(info.stdout)["id"]
            if isinstance(code, str) and len(code) == 14 and code[12] == "-" and code[:12].isdigit():
                self.device_short = code[:12]
                self.update_id()
        except (OSError, KeyError, ValueError, subprocess.SubprocessError):
            pass
        self.unit.connect("changed", self.update_id)
        self.status = Gtk.Label(label="Modo demonstracao" if preview else
                                "Informe o equipamento; a TI liberara o acesso completo na Intranet.")
        self.status.set_line_wrap(True)
        self.status.set_xalign(0)
        wrap.pack_start(self.status, False, False, 8)
        self.submit = Gtk.Button(label="Fechar" if preview else "Concluir configuracao")
        self.submit.get_style_context().add_class("suggested-action")
        self.submit.connect("clicked", self.finish)
        wrap.pack_start(self.submit, False, False, 8)

    @staticmethod
    def add_label(parent, text):
        label = Gtk.Label(label=text)
        label.set_xalign(0)
        label.set_line_wrap(True)
        parent.pack_start(label, False, False, 0)

    def close_event(self, *_):
        return not self.preview

    def company_changed(self, *_):
        self.unit.remove_all()
        rec = identity.COMPANIES.get(self.company.get_active_id())
        self.unit.append("", "Selecione uma loja" if rec else "Selecione primeiro a empresa")
        if rec:
            for code, name in rec["units"].items():
                self.unit.append(code, name)
        self.unit.set_active_id("")

    def update_id(self, *_):
        if self.device_short:
            suffix = firstboot.UNIT_SUFFIX.get(self.unit.get_active_id(), "0")
            self.device.set_text("Identificador: " + self.device_short + "-" + suffix)

    def finish(self, *_):
        if self.preview:
            Gtk.main_quit()
            return
        name = self.pc_name.get_text().strip()
        company = self.company.get_active_id()
        unit = self.unit.get_active_id()
        if not name or not company or not unit:
            self.notify("Preencha nome, empresa e loja.")
            return
        self.submit.set_sensitive(False)
        try:
            call = subprocess.run(["pkexec", "/usr/local/sbin/enfoque-firstboot-apply",
                                   name, company, unit], capture_output=True,
                                  text=True, timeout=35)
            if call.returncode != 0:
                raise RuntimeError(call.stderr.strip()[:180] or "Falha ao salvar o cadastro.")
            result = json.loads(call.stdout)
            if result.get("ok") is not True:
                raise RuntimeError("Cadastro nao confirmado.")
            try:
                identity.store_identity(self.username, company, unit)
            except FileExistsError:
                pass
            msg = ("Computador cadastrado! Identificacao: " + result.get("id", "") +
                   "\n\nA TI recebera a solicitacao automaticamente. No painel" +
                   " Acesso Remoto da Intranet, clique em Liberar acesso completo (root)." +
                   "\n\nNao e necessario digitar chave, codigo ou executar comandos neste PC.")
            popup = Gtk.MessageDialog(self, 0, Gtk.MessageType.INFO,
                                      Gtk.ButtonsType.OK, msg)
            popup.run()
            popup.destroy()
            Gtk.main_quit()
        except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
            self.notify(str(error)[:180])
        finally:
            self.submit.set_sensitive(True)

    def notify(self, text):
        self.status.set_text(text)
        popup = Gtk.MessageDialog(self, 0, Gtk.MessageType.WARNING,
                                  Gtk.ButtonsType.OK, text)
        popup.run()
        popup.destroy()


def main():
    preview = "--preview" in sys.argv
    if os.geteuid() == 0:
        return 1
    if running_live() and not preview:
        return 0
    if PROFILE.exists() and not preview:
        return 0
    dialog = Onboarding(preview)
    dialog.show_all()
    # A delayed, single focus request protects the first-run wizard from
    # other session startup windows, without stealing focus during polkit.
    if not preview:
        def focus_once():
            if not PROFILE.exists() and dialog.submit.get_sensitive():
                dialog.present()
            return False
        GLib.timeout_add(1700, focus_once)
    Gtk.main()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
