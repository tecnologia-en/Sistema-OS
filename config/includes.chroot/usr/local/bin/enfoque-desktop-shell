#!/usr/bin/env python3
"""Enfoque OS: menu tipo Windows 11, notificacoes persistentes e painel de impressoras.
GTK3/XFCE nativos; protocolo de controle via socket local do proprio usuario.
Nao concede privilegios e nunca instala drivers por conta propria.
"""
import os
import sys
import socket

def _fast_client():
    command = sys.argv[1] if len(sys.argv) > 1 else "menu"
    if command not in ("menu", "notifications", "printers", "calendar", "hide"):
        return False
    uid = os.getuid()
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    folder = runtime if runtime else os.path.join(
        os.path.expanduser("~"), ".cache", "enfoque-os")
    path = os.path.join(folder, "enfoque-shell-%d.sock" % uid)
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(0.45)
            client.connect(path)
            client.sendall(command.encode("ascii") + b"\n")
        return True
    except (ConnectionError, OSError, TimeoutError):
        return False


if __name__ == "__main__" and _fast_client():
    sys.exit(0)

import json
import threading
import subprocess
import shutil
import datetime
import time
from pathlib import Path
import configparser
import gi
