#!/usr/bin/env python3
"""A minimal Enfoque-branded disk installer; never starts Debian Calamares."""
import json
import os
from pathlib import Path
import subprocess
import sys
import threading

try:
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import GLib, Gtk
except (ImportError, ValueError):
    raise SystemExit("GTK3 indisponivel")

INSTALLER = "/usr/local/sbin/enfoque-install-system"


class Installer(Gtk.Window):
    def __init__(self):
        super().__init__(title="Instalar Enfoque OS")
        self.set_default_size(750, 580)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_border_width(28)
        self.connect("destroy", Gtk.main_quit)
        self.running = False
        self.disks = []
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        self.add(box)
        title = Gtk.Label()
        title.set_markup('<span weight="bold" size="xx-large">Instalar Enfoque OS</span>')
        title.set_xalign(0)
        box.pack_start(title, False, False, 0)
        intro = Gtk.Label(label="Escolha o disco interno onde o Enfoque OS sera instalado.\n"
                                "Apos a instalacao, informe o nome do PC e a loja no primeiro acesso.")
        intro.set_line_wrap(True)
        intro.set_xalign(0)
        box.pack_start(intro, False, False, 0)
        # Both controls work with a mouse in the Live ISO, without an Ethernet cable.
        tools = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
        wifi = Gtk.Button(label="Conectar ao Wi-Fi")
        wifi.connect("clicked", self.launch_helper, "/usr/local/bin/enfoque-configurar-wifi")
        tools.pack_start(wifi, False, False, 0)
        keyboard = Gtk.Button(label="Teclado virtual")
        keyboard.connect("clicked", self.launch_helper, "/usr/bin/onboard")
        tools.pack_start(keyboard, False, False, 0)
        box.pack_start(tools, False, False, 0)
        self.disk = Gtk.ComboBoxText()
        box.pack_start(Gtk.Label(label="Disco de destino (minimo 24 GiB)"), False, False, 0)
        box.pack_start(self.disk, False, False, 0)
        self.warning = Gtk.Label(label="ATENCAO: O DISCO ESCOLHIDO SERA APAGADO INTEGRALMENTE.\n"
                                  "Nunca selecione um disco com arquivos que deseja preservar.")
        self.warning.set_line_wrap(True)
        self.warning.set_xalign(0)
        box.pack_start(self.warning, False, False, 0)
        self.erase_mode = Gtk.RadioButton.new_with_label_from_widget(
            None, "Apagar tudo e instalar (modo original)")
        self.keep_mode = Gtk.RadioButton.new_with_label_from_widget(
            self.erase_mode, "Manter arquivos pessoais usando o servidor")
        self.erase_mode.set_active(True)
        self.erase_mode.connect("toggled", self.update_mode)
        box.pack_start(self.erase_mode, False, False, 0)
        box.pack_start(self.keep_mode, False, False, 0)
        self.code = Gtk.Entry()
        self.code.set_placeholder_text("Codigo temporario da TI para o backup seguro")
        self.code.set_visibility(False)
        self.code.set_sensitive(False)
        box.pack_start(self.code, False, False, 0)
        self.confirm = Gtk.Entry()
        self.confirm.set_placeholder_text("Digite APAGAR para confirmar")
        box.pack_start(self.confirm, False, False, 0)
        self.status = Gtk.Label(label="Procurando discos internos...")
        self.status.set_xalign(0)
        self.status.set_line_wrap(True)
        box.pack_start(self.status, False, False, 0)
        self.progress = Gtk.ProgressBar()
        box.pack_start(self.progress, False, False, 0)
        row = Gtk.Box(spacing=12)
        self.refresh = Gtk.Button(label="Atualizar discos")
        self.refresh.connect("clicked", self.refresh_disks)
        self.submit = Gtk.Button(label="Instalar no disco selecionado")
        self.submit.get_style_context().add_class("destructive-action")
        self.submit.connect("clicked", self.start)
        row.pack_start(self.refresh, False, False, 0)
        row.pack_end(self.submit, False, False, 0)
        box.pack_end(row, False, False, 0)
        self.update_mode()
        self.refresh_disks()

    def launch_helper(self, _button, program):
        try:
            subprocess.Popen([program], stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
        except OSError:
            self.message("Recurso indisponivel nesta instalacao.", True)

    def message(self, message, warning=False):
        dialog = Gtk.MessageDialog(self, 0, Gtk.MessageType.WARNING if warning
                                   else Gtk.MessageType.INFO, Gtk.ButtonsType.OK,
                                   message)
        dialog.run()
        dialog.destroy()

    def refresh_disks(self, *_):
        self.disk.remove_all()
        self.disks = []
        try:
            run = subprocess.run([INSTALLER, "--list-disks"], capture_output=True,
                                 text=True, timeout=15, check=True)
            self.disks = json.loads(run.stdout)
            for disk in self.disks:
                gib = disk["size"] / 1024 ** 3
                self.disk.append(disk["path"], f'{disk["path"]} - {gib:.0f} GiB - {disk["model"]}')
            if self.disks:
                self.disk.set_active(0)
                self.status.set_text(f'{len(self.disks)} disco(s) interno(s) elegivel(is).')
            else:
                self.status.set_text("Nenhum disco interno elegivel. Nenhum dispositivo sera alterado.")
        except (OSError, ValueError, subprocess.SubprocessError) as error:
            self.status.set_text("Nao foi possivel consultar discos: " + str(error)[:100])

    def update_mode(self, *_):
        keeping = self.keep_mode.get_active()
        self.code.set_sensitive(keeping)
        if not keeping:
            self.code.set_text("")
        self.confirm.set_text("")
        self.confirm.set_placeholder_text(
            "Digite MANTER para confirmar" if keeping
            else "Digite APAGAR para confirmar")
        self.warning.set_text(
            "A instalacao vai enviar arquivos pessoais por HTTPS ao servidor "
            "temporario da Enfoque, verificar tudo ANTES de formatar, instalar "
            "o sistema e restaurar Area de Trabalho, Downloads, Documentos, "
            "Imagens, Videos e Musicas. O servidor apaga o backup apos o "
            "primeiro boot e verificacao completa. Exige internet e codigo "
            "temporario da TI; nao requer outro disco ou pendrive de dados."
            if keeping else
            "ATENCAO: O DISCO ESCOLHIDO SERA APAGADO INTEGRALMENTE. "
            "Nunca use este modo quando precisar preservar arquivos.")

    def start(self, *_):
        disk = self.disk.get_active_id()
        if not disk or disk not in [d["path"] for d in self.disks]:
            self.message("Selecione um disco interno valido.", True)
            return
        mode = "preserve" if self.keep_mode.get_active() else "erase"
        confirmation = "MANTER" if mode == "preserve" else "APAGAR"
        code = self.code.get_text().strip() if mode == "preserve" else ""
        if self.confirm.get_text().strip() != confirmation:
            self.message("Digite " + confirmation + " para confirmar.", True)
            return
        if mode == "preserve":
            if not code:
                self.message("Solicite o codigo temporario de instalacao a TI.", True)
                return
            self.message(
                "Antes de apagar o sistema, os arquivos pessoais do disco " + disk +
                " serao enviados por HTTPS ao servidor da Enfoque e verificados. "
                "A instalacao so comecara depois da confirmacao do backup. "
                "Nao desligue o equipamento ate concluir.", True)
        else:
            self.message("O disco " + disk + " sera completamente apagado.\n"
                         "Ao fechar esta mensagem a instalacao comecara.", True)
        self.install_mode = mode
        self.running = True
        self.submit.set_sensitive(False)
        self.refresh.set_sensitive(False)
        self.disk.set_sensitive(False)
        self.confirm.set_sensitive(False)
        self.code.set_sensitive(False)
        self.erase_mode.set_sensitive(False)
        self.keep_mode.set_sensitive(False)
        self.status.set_text("Enviando e verificando arquivos no servidor..." if mode == "preserve"
                             else "Preparando disco e copiando o Enfoque OS...")
        self.progress.pulse()
        threading.Thread(target=self.run_install, args=(disk, mode, code), daemon=True).start()
        GLib.timeout_add(400, self.pulse)

    def pulse(self):
        if not self.running:
            return False
        self.progress.pulse()
        return True

    def progress_line(self, line):
        if "ENFOQUE_INSTALL_ERROR" in line or "Enfoque OS:" in line:
            self.status.set_text(line.strip()[:180])
        return False

    def run_install(self, disk, mode, code):
        try:
            # Pass the one-time code via STDIN, never in the process command line.
            process = subprocess.Popen(["sudo", "-n", INSTALLER, "--disk", disk,
                                        "--mode", mode, "--confirm",
                                        "MANTER" if mode == "preserve" else "APAGAR"],
                                       stdin=subprocess.PIPE,
                                       stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                       text=True, bufsize=1)
            if mode == "preserve":
                process.stdin.write(code + "\n")
            process.stdin.close()
            error_text = ""
            for line in process.stdout:
                GLib.idle_add(self.progress_line, line)
                if "ENFOQUE_INSTALL_ERROR" in line:
                    error_text = line.strip()[:350]
            status = process.wait(timeout=30)
            GLib.idle_add(self.done, status == 0, error_text)
        except (OSError, subprocess.SubprocessError) as error:
            GLib.idle_add(self.done, False, str(error)[:180])

    def done(self, success, detail=""):
        self.running = False
        self.submit.set_sensitive(not success)
        self.refresh.set_sensitive(not success)
        if success:
            # The live desktop still reads files from the USB. Removing it before
            # poweroff can crash XFCE plug-ins and cause I/O errors in the session.
            self.status.set_text(
                "Instalacao concluida. MANTENHA O PENDRIVE CONECTADO ate o PC desligar."
                + (" Arquivos restaurados; backup no servidor sera removido apos "
                   "o primeiro boot confirmado." if self.install_mode == "preserve" else "")
            )
            dialog = Gtk.MessageDialog(
                self, 0, Gtk.MessageType.INFO, Gtk.ButtonsType.NONE,
                "Instalacao concluida!"
            )
            dialog.format_secondary_text(
                "Nao retire o pendrive enquanto o Enfoque OS estiver ligado.\n\n"
                "Clique em 'Desligar com seguranca' e aguarde o PC apagar "
                "completamente. SOMENTE ENTAO remova o pendrive e ligue o PC "
                "para iniciar pelo disco interno.\n\n"
                "No primeiro login: usuario enfoque, senha temporaria 123456. "
                "Troque a senha e identifique a empresa e a loja."
                + ("\n\nConfira os arquivos restaurados nas suas pastas. "
                   "O backup remoto sera apagado apos o primeiro boot verificado."
                   if self.install_mode == "preserve" else "")
            )
            dialog.add_button("Desligar com seguranca", Gtk.ResponseType.OK)
            dialog.add_button("Fazer depois", Gtk.ResponseType.CANCEL)
            response = dialog.run()
            dialog.destroy()
            if response == Gtk.ResponseType.OK:
                self.status.set_text("Desligando. NAO retire o pendrive ate o PC apagar.")
                try:
                    subprocess.run(
                        ["sudo", "-n", "systemctl", "poweroff"],
                        check=True, timeout=15, capture_output=True, text=True,
                    )
                except (OSError, subprocess.SubprocessError) as error:
                    self.status.set_text(
                        "Nao foi possivel desligar automaticamente. "
                        "Mantenha o pendrive conectado e desligue o PC com seguranca."
                    )
                    self.message(
                        "O desligamento automatico falhou.\n" + str(error)[:160]
                        + "\nMantenha o pendrive conectado ate desligar.", True
                    )
        else:
            self.disk.set_sensitive(True)
            self.confirm.set_sensitive(True)
            self.erase_mode.set_sensitive(True)
            self.keep_mode.set_sensitive(True)
            self.update_mode()
            self.status.set_text("Instalacao nao concluida. Verifique as mensagens do instalador.")
            self.message("Instalacao nao concluida.\n" + detail +
                         "\nNao use o disco ate corrigir o problema.", True)
        return False


def main():
    if not Path("/run/live/medium").exists():
        print("Instalador disponivel apenas ao iniciar pelo pendrive.", file=sys.stderr)
        return 1
    window = Installer()
    window.show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
