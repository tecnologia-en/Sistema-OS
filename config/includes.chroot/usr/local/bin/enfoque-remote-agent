#!/usr/bin/env python3
"""Enfoque OS Root MCP agent: per-installation keys, explicit admin approval.

Never ship credentials in the ISO; never execute arbitrary shell or root code.
Visual frames and input are served on demand through the logged-in XFCE session.
"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import platform
import re
import secrets
import shlex
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request
import uuid

SERVER = "https://mcp.enfoquepapelaria.com.br/mcp/pc-agent"
STATE = Path(os.environ.get("STATE_DIRECTORY", "/var/lib/enfoque-agent"))
DEVICE = Path("/var/lib/enfoque-os/device-identity.json")
LIVE_DEVICE = Path("/run/enfoque-os/device-identity.json")
PROFILE = Path("/var/lib/enfoque-os/firstboot.json")
STORE_SUFFIX = {"ilha-plaza":"1","copacabana":"2","itaipu":"3","icarai":"4","sao-goncalo":"5","centro":"6","deposito":"7","administracao":"8","papel-arte":"9"}
AGENT_VERSION = "0.2.41-linux-visual-ondemand"

def installed_version():
    try:
        content = Path("/etc/enfoque-os-release").read_text(encoding="utf-8")
        match = re.search(r'^VERSION="([^"]+)"$', content, flags=re.MULTILINE)
        return match.group(1) if match else "desconhecida"
    except OSError:
        return "desconhecida"

SAFE_READ = frozenset(("/etc/enfoque-os-release", "/etc/os-release", "/proc/meminfo", "/proc/uptime"))
SAFE_DIR = frozenset(("/usr/share/applications", "/usr/local/bin", "/etc/xdg"))
SAFE_UNITS = frozenset((
    "enfoque-device-id.service", "enfoque-remote-agent.service",
    "enfoque-telemetria.service", "enfoque-captura-tela.service",
    "anydesk.service", "NetworkManager.service", "cups.service",
    "lightdm.service", "meshagent.service",
))
METACHARS = frozenset(";|&<>$\\\n\r" + chr(96))


def machine_identity():
    path = LIVE_DEVICE if Path("/run/live/medium").exists() else DEVICE
    record = json.loads(path.read_text(encoding="utf8"))
    canonical = uuid.UUID(record["uuid"])
    if canonical.version != 4 or str(canonical) != record["uuid"]:
        raise ValueError("UUID local invalido")
    if record["shortId"] != f"{canonical.int % 1000000000000:012d}":
        raise ValueError("Codigo local inconsistente")
    return record


def local_state(folder=STATE):
    record = machine_identity()
    folder = Path(folder)
    folder.mkdir(parents=True, mode=0o700, exist_ok=True)
    if folder.is_symlink() and (folder != Path("/var/lib/enfoque-agent") or folder.lstat().st_uid != 0 or folder.resolve(strict=True) != Path("/var/lib/private/enfoque-agent")):
        raise PermissionError("Pasta de credenciais insegura")
    if folder.stat().st_mode & 0o077:
        raise PermissionError("Diretorio de credenciais com permissoes inseguras")
    filename = folder / "identity.json"
    name = "enfoqueos-" + record["uuid"]
    if filename.exists():
        if filename.is_symlink() or filename.stat().st_mode & 0o077:
            raise PermissionError("Credencial do agente sem protecao")
        data = json.loads(filename.read_text(encoding="utf8"))
        if data.get("deviceId") != name or not re.fullmatch(r"[0-9a-f]{64}", str(data.get("token", ""))):
            raise ValueError("ID alterado ou estado do agente invalido")
        return data
    data = {"schema": 1, "deviceId": name, "token": secrets.token_hex(32)}
    fd = os.open(filename, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w", encoding="utf8") as output:
        json.dump(data, output)
        output.write("\n")
        output.flush()
        os.fsync(output.fileno())
    return data


def display_identity():
    """Inventory name comes from the validated, root-owned on-disk setup.

    Never depend on an XDG user profile or a subprocess from DynamicUser.
    No machine can register before its first installed setup is complete.
    """
    record = machine_identity()
    code = record["shortId"] + "-0"
    store = "Loja ainda nao vinculada"
    if Path("/run/live/medium").exists():
        return code, store
    try:
        if PROFILE.is_symlink():
            return code, store
        meta = PROFILE.stat()
        if meta.st_uid != 0 or meta.st_mode & 0o022:
            return code, store
        data = json.loads(PROFILE.read_text(encoding="utf-8"))
        suffix = STORE_SUFFIX.get(data.get("unitId"))
        if not suffix or data.get("uuid") != record["uuid"] or data.get("shortId") != record["shortId"]:
            return code, store
        expected = record["shortId"] + "-" + suffix
        if data.get("displayId") != expected:
            return code, store
        name, unit = data.get("pcName"), data.get("unitName")
        if not isinstance(name, str) or not 3 <= len(name) <= 48:
            return code, store
        if not isinstance(unit, str) or not 3 <= len(unit) <= 45:
            return code, store
        if not re.fullmatch(r"[A-Za-zÀ-ÿ0-9 _.-]{3,48}", name):
            return code, store
        if any(c in "\r\n\0" for c in unit):
            return code, store
        code = expected
        store = name + " / " + unit
        anydesk = data.get("anydeskId")
        if isinstance(anydesk, str) and re.fullmatch(r"[0-9]{6,16}", anydesk):
            store += " / AnyDesk " + anydesk
    except (OSError, TypeError, ValueError, KeyError):
        pass
    return code, store


def command_argv(program, args):
    """Only audited read-only diagnostics; no shell, interpreter, write, or sudo."""
    if not isinstance(program, str) or not isinstance(args, list) or len(args) > 8:
        raise PermissionError("Formato de comando nao permitido")
    if any(not isinstance(x, str) or len(x) > 75 for x in args):
        raise PermissionError("Argumentos nao permitidos")
    name = os.path.basename(program)
    allowed = (
        (name == "free" and args in ([], ["-h"], ["-m"]))
        or (name == "df" and args in ([], ["-h"], ["-h", "/"]))
        or (name == "uptime" and args in ([], ["-p"]))
        or (name == "uname" and args in ([], ["-a"], ["-r"]))
        or (name == "hostname" and args == [])
        or (name == "lsusb" and args == [])
        or (name == "id" and args == [])
        or (name == "ps" and args in (["-ef"], ["-eo", "pid,comm,%cpu,%mem"]))
        or (name == "systemctl" and len(args) == 2
            and args[0] in ("status", "is-active", "is-enabled")
            and args[1] in SAFE_UNITS)
    )
    if not allowed:
        raise PermissionError("Operacao bloqueada pela politica de TI")
    return ["/usr/bin/" + name, *args]


def command_result(program, args):
    try:
        completed = subprocess.run(command_argv(program, args), timeout=8,
                                   stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                   text=True, stdin=subprocess.DEVNULL,
                                   env={"PATH": "/usr/bin:/bin", "LANG": "C"})
        return {"ok": completed.returncode == 0, "exitCode": completed.returncode,
                "stdout": completed.stdout[:12000], "stderr": completed.stderr[:1500]}
    except (PermissionError, ValueError, OSError, subprocess.SubprocessError) as error:
        return {"ok": False, "error": type(error).__name__ + ": " + str(error)[:120]}


def exact_path(value, permitted):
    if not isinstance(value, str) or value not in permitted:
        raise PermissionError("Caminho nao autorizado")
    source = Path(value)
    if source.is_symlink() or str(source.resolve(strict=True)) != value:
        raise PermissionError("Caminho modificado")
    return source


def session_request(action, args):
    # DynamicUser continues to own only the outbound TLS connection.
    # Actual GUI programs and user shell run under the logged-in user through
    # the local Unix socket, never as root and never with server secrets.
    library = Path(__file__).resolve().parent.parent / "lib/enfoque-session"
    if str(library) not in sys.path:
        sys.path.insert(0, str(library))
    try:
        from bridge import session_command
        return session_command(action, args)
    except (ImportError, OSError, ValueError) as error:
        return {"ok": False, "error": "Agente da sessão indisponível: " +
                type(error).__name__}


def audit_remote(command_id, action, args, result):
    if not isinstance(command_id, str):
        return
    # Deliberately do not log commands or outputs, which can contain secrets.
    log = STATE / "command-audit.jsonl"
    record = {
        "time": time.time(), "id": command_id[:80],
        "action": str(action)[:35], "ok": result.get("ok") is True,
        "context": result.get("scope", "servico-restrito"),
        "sessionUser": result.get("sessionUser", ""),
    }
    try:
        log.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        if log.exists() and log.stat().st_size > 2_000_000:
            log.replace(log.with_suffix(".previous"))
        with log.open("a", encoding="utf-8") as f:
            f.write(json.dumps(record, ensure_ascii=False) + "\n")
        log.chmod(0o600)
    except OSError:
        pass


def handle_action(action, args):
    args = args if isinstance(args, dict) else {}
    if action in ("screenshot", "gui"):
        # The existing user IPC socket requires an active, authenticated XFCE
        # session. The remote server approves requests; the agent never polls
        # pixels or controls the mouse on its own.
        return session_request(action, args)
    if action == "open":
        return session_request("open", args)
    if action in ("shell", "run"):
        # Optional /diagnostic mode retains the existing tightly scoped
        # headless read-only tools; normal terminal uses the USER session.
        if args.get("scope") != "diagnostic":
            return session_request(action, args)
    if action == "process":
        outcome = session_request("process", args)
        if outcome.get("ok") is True or args.get("op") != "list":
            return outcome
        return command_result("ps", ["-eo", "pid,comm,%cpu,%mem"])
    if action == "session_status":
        return session_request("status", {})

    if action == "shell":
        script = args.get("command")
        if not isinstance(script, str) or len(script) > 200 or any(ch in METACHARS for ch in script):
            return {"ok": False, "error": "Shell livre nao autorizado"}
        try:
            tokens = shlex.split(script)
        except ValueError:
            return {"ok": False, "error": "Sintaxe invalida"}
        return command_result(tokens[0], tokens[1:]) if tokens else {"ok": False, "error": "Comando vazio"}
    if action == "run":
        return command_result(args.get("program"), args.get("args", []))
    if action == "process" and args.get("op") == "list":
        return command_result("ps", ["-eo", "pid,comm,%cpu,%mem"])
    if action == "read_file":
        try:
            file = exact_path(args.get("path"), SAFE_READ)
            return {"ok": True, "path": str(file),
                    "content": file.read_text(encoding="utf8", errors="replace")[:8000]}
        except (OSError, PermissionError) as e:
            return {"ok": False, "error": type(e).__name__}
    if action == "list_directory":
        try:
            folder = exact_path(args.get("path"), SAFE_DIR)
            entries = [{"name": p.name[:100], "isDir": p.is_dir()}
                       for p in list(folder.iterdir())[:150] if not p.is_symlink()]
            return {"ok": True, "path": str(folder), "entries": entries}
        except (OSError, PermissionError) as e:
            return {"ok": False, "error": type(e).__name__}
    return {"ok": False, "error": "Apenas leitura; use MeshCentral autorizado para controle interativo"}


def request(suffix, payload, token=None, base=SERVER, device_id=None):
    headers = {"Content-Type": "application/json"}
    if token is not None:
        # The gateway requires BOTH the approved device ID and its individual
        # token. Never treat a token alone as permission to poll commands.
        if not isinstance(device_id, str) or not re.fullmatch(r"[A-Za-z0-9._:-]{6,160}", device_id):
            raise ValueError("Identificador de dispositivo ausente ou invalido")
        headers["Authorization"] = "Bearer " + token
        headers["X-PC-Device-ID"] = device_id
    encoded = json.dumps(payload, separators=(",", ":")).encode("utf8")
    req = urllib.request.Request(base + suffix, encoded, headers=headers, method="POST")
    with urllib.request.urlopen(req, timeout=10) as response:
        if response.status != 200:
            raise RuntimeError("Resposta remota inesperada")
        answer = response.read(100001)
    if len(answer) > 100000:
        raise RuntimeError("Resposta remota excessiva")
    return json.loads(answer)


def send_register(state, base=SERVER):
    short, store = display_identity()
    return request("/register", {"deviceId": state["deviceId"],
       "tokenHash": hashlib.sha256(state["token"].encode("ascii")).hexdigest(),
       "hostname": ("Enfoque OS " + short + " " + store)[:100],
       "username": "enfoque-agent",
       "platform": "Linux Enfoque OS " + installed_version() + " XFCE"}, base=base)


def run_cycle(state, base=SERVER):
    registered = send_register(state, base)
    if registered.get("approved") is not True:
        return False
    short, store = display_identity()
    inventory_name = ("Enfoque OS " + short + " " + store)[:100]
    pending = request("/poll", {"hostname": inventory_name,
        "username": "enfoque-agent", "platform": platform.platform(),
        "agentVersion": AGENT_VERSION}, state["token"], base, state["deviceId"])
    cmd = pending.get("command")
    if isinstance(cmd, dict) and isinstance(cmd.get("id"), str):
        result = handle_action(cmd.get("action"), cmd.get("args"))
        audit_remote(cmd["id"], cmd.get("action"), cmd.get("args"), result)
        request("/result", {"id": cmd["id"], "result": result},
                state["token"], base, state["deviceId"])
    return True


def websocket_cycle(state, base=SERVER, *, max_commands=None):
    """Outgoing WSS only; HTTP polling remains fallback for older network paths."""
    library = Path(__file__).resolve().parent.parent / "lib/enfoque-session"
    if str(library) not in sys.path:
        sys.path.insert(0, str(library))
    from channel import WebSocket
    from urllib.parse import urlsplit
    parsed = urlsplit(base)
    if parsed.scheme != "https":
        raise ValueError("WebSocket corporativo exige HTTPS/TLS")
    uri = "wss://" + parsed.netloc + parsed.path.rstrip("/") + "/ws"
    short, store = display_identity()
    ws = WebSocket(uri, state["deviceId"], state["token"])
    count = 0
    try:
        ws.connect()
        ws.send_json({"type":"hello",
             "hostname":("Enfoque OS "+short+" "+store)[:100],
             "username":"enfoque-agent",
             "platform":platform.platform(),"agentVersion":AGENT_VERSION})
        while True:
            packet = ws.recv_json()
            if packet.get("type") != "command":
                continue
            task = packet.get("command")
            if not isinstance(task,dict):
                continue
            ident = task.get("id")
            if not isinstance(ident,str) or not 1<=len(ident)<=80:
                continue
            result = handle_action(task.get("action"),task.get("args"))
            audit_remote(ident, task.get("action"), task.get("args"), result)
            ws.send_json({"type":"result","id":ident,"result":result})
            count += 1
            if max_commands is not None and count>=max_commands:
                return count
    finally:
        ws.close()

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--once", action="store_true", help="Apenas um ciclo HTTP autenticado")
    options = parser.parse_args()
    while True:
        try:
            state = local_state()
            if options.once:
                return 0 if run_cycle(state) else 2
            registered = send_register(state)
            if registered.get("approved") is not True:
                time.sleep(25)
                continue
            # Normal operation: persistent outgoing websocket, no port at PC.
            # If blocked by a firewall/proxy, use proven HTTP polling temporarily.
            try:
                websocket_cycle(state)
            except (OSError, ValueError, RuntimeError, ConnectionError,
                    urllib.error.URLError, json.JSONDecodeError) as error:
                print("Enfoque WebSocket: "+type(error).__name__+
                      ". Usando fallback HTTP.",file=sys.stderr)
                for _ in range(4):
                    try:
                        if not run_cycle(state):
                            break
                    except (OSError, ValueError, RuntimeError, urllib.error.URLError,
                            json.JSONDecodeError):
                        break
                    time.sleep(4)
        except (OSError, ValueError, RuntimeError, urllib.error.URLError,
                json.JSONDecodeError) as error:
            print("Enfoque agente remoto: "+type(error).__name__,file=sys.stderr)
            if options.once:
                return 1
            time.sleep(20)

if __name__ == "__main__":
    sys.exit(main())
