#!/usr/bin/env python3
"""Executa PayGo Windows no Wine 32-bit, apenas em ambiente de laboratorio."""
import argparse
import glob
import os
from pathlib import Path
import shutil
import subprocess
import sys

# O instalador verificado e PE32, portanto nao misturar prefixo win64 e Wine32.
DEFAULT_PREFIX = Path.home() / ".local" / "share" / "enfoque-os" / "paygo-win32"
PREFIX = Path(os.environ.get("ENFOQUE_PAYGO_PREFIX", str(DEFAULT_PREFIX))).expanduser()
WINE32 = Path("/usr/lib/wine/wine")
SETUP = Path("/opt/enfoque/paygo/SetupPayGo.exe")
MIN_FREE_INIT = 900 * 1024 * 1024
MIN_FREE_INSTALL = 650 * 1024 * 1024
GERTEC_PINPAD = Path("/dev/enfoque-pinpad")
os.environ["WINEPREFIX"] = str(PREFIX)
os.environ["WINEARCH"] = "win32"
os.environ["WINELOADER"] = str(WINE32)
os.environ.setdefault("WINEDEBUG", "err+all")


def aviso(mensagem, erro=False):
    if shutil.which("zenity") and os.environ.get("DISPLAY"):
        subprocess.run(
            ["zenity", "--error" if erro else "--info",
             "--title=PayGo - Enfoque OS (piloto)", "--width=470",
             "--text=" + mensagem], check=False)
    else:
        print(mensagem, file=sys.stderr)


def armazenamento_suficiente(minimo):
    disponivel = shutil.disk_usage(PREFIX.parent).free
    if disponivel >= minimo:
        return True
    mb = disponivel // (1024 * 1024)
    aviso(
        "Sem espaco para criar o Windows do PayGo: somente "
        + str(mb) + " MB livres. No modo Live, as alteracoes ficam "
        "num disco temporario limitado. Instale o Enfoque OS no disco "
        "ou use ENFOQUE_PAYGO_PREFIX num volume gravavel de laboratorio.",
        True)
    return False


def comando_wine(*argumentos, timeout=None):
    return subprocess.run([str(WINE32), *argumentos], timeout=timeout, check=False).returncode


def mapear_pinpad_detectado():
    """Expoe a GERTEC no prefixo Wine, sem modificar outros dispositivos."""
    if not GERTEC_PINPAD.exists() or not os.access(
            GERTEC_PINPAD, os.R_OK | os.W_OK):
        return False
    dos = PREFIX / "dosdevices"
    if not dos.is_dir():
        return False
    mapeado = False
    for porta in ("com1", "com8"):
        com = dos / porta
        if com.is_symlink():
            destino_atual = os.readlink(com)
            if destino_atual == str(GERTEC_PINPAD):
                mapeado = True
                continue
            if porta == "com1" and destino_atual.startswith("/dev/ttyS"):
                com.unlink()
            else:
                # Nao trocar mapeamento personalizado por outro operador.
                continue
        elif com.exists():
            continue
        com.symlink_to(GERTEC_PINPAD)
        mapeado = True
    return mapeado


def wine_pronto():
    if not PREFIX.is_absolute():
        aviso("O caminho do ambiente Wine precisa ser absoluto.", True)
        return False
    if not WINE32.is_file():
        aviso("Carregador Wine32 ausente na ISO; verifique a instalacao.", True)
        return False
    PREFIX.parent.mkdir(parents=True, exist_ok=True)
    PREFIX.mkdir(parents=True, exist_ok=True, mode=0o700)
    PREFIX.chmod(0o700)
    pronto = PREFIX / ".enfoque-wine32-ready"
    if pronto.is_file():
        mapear_pinpad_detectado()
        return True
    if not armazenamento_suficiente(MIN_FREE_INIT):
        return False
    aviso("Configurando Wine de 32 bits. A primeira inicializacao pode demorar.")
    try:
        if comando_wine("wineboot.exe", "--init", timeout=145):
            raise RuntimeError("wineboot retornou erro")
        validacao = subprocess.run(
            [str(WINE32), "cmd.exe", "/c", "echo", "ENFOQUE_WINE_OK"],
            capture_output=True, text=True, timeout=35, check=False)
        if validacao.returncode or "ENFOQUE_WINE_OK" not in validacao.stdout:
            raise RuntimeError("falha na verificacao de DLLs do Wine32")
    except (RuntimeError, OSError, subprocess.TimeoutExpired) as erro:
        aviso("Falha ao inicializar o Wine32: " + str(erro) +
              ". O programa PayGo nao foi executado.", True)
        return False
    pronto.write_text("Wine32 testado com cmd.exe\n")
    mapear_pinpad_detectado()
    return True


def principal_instalado():
    """Usa apenas nomes de executaveis PayGo, nunca o nome do prefixo."""
    encontrados = []
    ignorar = ("setup", "unins", "update", "install", "remove", "repair",
               "collector", "teste", "test", "helper")
    for pasta in ("Program Files", "Program Files (x86)"):
        raiz = PREFIX / "drive_c" / pasta
        if not raiz.is_dir():
            continue
        for diretorio, subdirs, nomes in os.walk(raiz):
            subdirs[:] = [d for d in subdirs if d.lower() not in
                          ("uninstall", "uninstaller", "updates", "temp")]
            for nome in nomes:
                curto = nome.lower()
                if not curto.endswith(".exe") or any(
                        p in curto for p in ignorar):
                    continue
                if curto == "paygo.exe":
                    prioridade = 0
                elif curto in ("paygowindows.exe", "pgwin.exe"):
                    prioridade = 1
                elif "paygo" in curto or "pgwin" in curto:
                    prioridade = 2
                else:
                    continue
                caminho = Path(diretorio) / nome
                encontrados.append(((prioridade, len(str(caminho))), caminho))
    return min(encontrados)[1] if encontrados else None


def instalar():
    if not SETUP.is_file():
        aviso("O instalador oficial PayGo nao foi encontrado na ISO.", True)
        return False
    if not armazenamento_suficiente(MIN_FREE_INSTALL):
        return False
    aviso("Instalacao experimental PayGo Windows (32-bit). "
          "Nao ative terminais de producao nem processe pagamentos.")
    try:
        codigo = comando_wine(str(SETUP), timeout=1200)
    except (OSError, subprocess.TimeoutExpired) as erro:
        aviso("Instalador PayGo nao concluiu: " + str(erro), True)
        return False
    if codigo:
        aviso("O instalador retornou erro. Nao utilize em caixa real.", True)
        return False
    return True


def portas():
    caminhos = sorted(set(
        p for padrao in ("/dev/enfoque-pinpad", "/dev/serial/by-id/*", "/dev/ttyUSB*", "/dev/ttyACM*")
        for p in glob.glob(padrao) if os.path.exists(p)))
    if not caminhos:
        aviso("Nenhuma porta serial USB encontrada. Nenhuma alteracao realizada.")
        return 0
    if not (shutil.which("zenity") and os.environ.get("DISPLAY")):
        print("\n".join(caminhos))
        return 0
    res = subprocess.run(
        ["zenity", "--list", "--title=Selecionar PIN-pad",
         "--width=720", "--height=360", "--column=Dispositivo Linux",
         *caminhos], text=True, capture_output=True, check=False)
    selecionado = res.stdout.strip()
    if res.returncode or selecionado not in caminhos:
        return 0
    if not os.access(selecionado, os.R_OK | os.W_OK):
        aviso("Permissao USB insuficiente. Solicite verificacao da TI.", True)
        return 1
    dos = PREFIX / "dosdevices"
    dos.mkdir(parents=True, exist_ok=True)
    com = dos / "com1"
    if com.is_symlink():
        com.unlink()
    elif com.exists():
        aviso("COM1 ja existe; mapeamento preservado.", True)
        return 1
    com.symlink_to(selecionado)
    aviso("COM1 mapeada para " + selecionado + ". PIN-pad nao homologado.")
    return 0


def main():
    parser = argparse.ArgumentParser(description="PayGo Windows no Wine32")
    parser.add_argument(
        "acao", nargs="?", choices=["abrir", "instalar", "configurar",
                                    "portas", "diagnostico"], default="abrir")
    acao = parser.parse_args().acao
    if acao == "diagnostico":
        print("Wine32:", WINE32 if WINE32.is_file() else "ausente")
        print("Arquitetura: win32")
        print("Instalador:", "presente" if SETUP.is_file() else "ausente")
        print("Prefixo:", PREFIX)
        print("Espaco livre:", shutil.disk_usage(Path.home()).free // 1048576, "MB")
        print("Live temporario:", Path("/run/live/overlay").exists())
        print("Executavel:", principal_instalado() or "nao localizado")
        print("GERTEC PPC930:", "detectada" if GERTEC_PINPAD.exists()
              else "nao conectada")
        print("Porta COM:", "mapeada" if mapear_pinpad_detectado()
              else "pendente ou sem permissao")
        print("Status: piloto, sem homologacao para pagamentos reais")
        return 0
    if not wine_pronto():
        return 1
    if acao == "configurar":
        return comando_wine("winecfg.exe")
    if acao == "portas":
        return portas()
    aplicativo = principal_instalado()
    if acao == "instalar" or aplicativo is None:
        if not instalar():
            return 1
        aplicativo = principal_instalado()
    if aplicativo is None:
        aviso("Instalacao concluida, mas executavel PayGo nao localizado. "
              "Confira as dependencias do Windows e os logs.", True)
        return 1
    return comando_wine(str(aplicativo))


if __name__ == "__main__":
    sys.exit(main())
