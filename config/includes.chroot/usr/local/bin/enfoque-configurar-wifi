#!/usr/bin/env python3
"""Enfoque OS: mouse-first Wi-Fi selector for Live installer and installed OS."""
import os
from pathlib import Path
import shutil
import subprocess
import sys
import threading

sys.path.insert(0, "/usr/local/lib/enfoque-wifi")
from scan import build_connect_argv, diagnose, has_wifi_device, parse_access_points

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk

NMCLI = shutil.which("nmcli") or "/usr/bin/nmcli"


def run_nmcli(arguments, *, timeout=25, input_text=None):
    return subprocess.run([NMCLI, *arguments], input=input_text, capture_output=True,
                          text=True, timeout=timeout, check=False)


class WifiSetup(Gtk.Window):
    def __init__(self):
        super().__init__(title="Enfoque OS - Conectar ao Wi-Fi")
        self.set_default_size(590, 470)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_border_width(20)
        self.set_keep_above(True)
        self.connect("destroy", Gtk.main_quit)
        self.networks = []
        self.busy = False
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=11)
        self.add(body)

        head = Gtk.Label()
        head.set_markup('<span weight="bold" size="x-large">Conectar ao Wi-Fi</span>')
        head.set_xalign(0)
        body.pack_start(head, False, False, 0)
        intro = Gtk.Label(label="Escolha uma rede e conecte antes de fazer backup ou instalar.\n"
                                  "A rede cabeada continua funcionando normalmente.")
        intro.set_line_wrap(True)
        intro.set_xalign(0)
        body.pack_start(intro, False, False, 0)

        self.status = Gtk.Label(label="Procurando redes Wi-Fi...")
        self.status.set_xalign(0)
        self.status.set_line_wrap(True)
        body.pack_start(self.status, False, False, 0)

        label = Gtk.Label(label="Redes disponiveis")
        label.set_xalign(0)
        body.pack_start(label, False, False, 0)
        self.network = Gtk.ComboBoxText()
        self.network.connect("changed", self.network_selected)
        body.pack_start(self.network, False, False, 0)

        self.hidden_toggle = Gtk.CheckButton(label="Rede oculta / informar SSID manualmente")
        self.hidden_toggle.connect("toggled", self.network_selected)
        body.pack_start(self.hidden_toggle, False, False, 0)
        self.ssid = Gtk.Entry()
        self.ssid.set_placeholder_text("Nome da rede (SSID)")
        self.ssid.set_no_show_all(True)
        self.ssid.hide()
        body.pack_start(self.ssid, False, False, 0)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.password = Gtk.Entry()
        self.password.set_placeholder_text("Senha da rede Wi-Fi (quando necessaria)")
        self.password.set_visibility(False)
        self.password.set_hexpand(True)
        row.pack_start(self.password, True, True, 0)
        self.show_password = Gtk.CheckButton(label="Mostrar")
        self.show_password.connect("toggled", lambda button:
                                   self.password.set_visibility(button.get_active()))
        row.pack_end(self.show_password, False, False, 0)
        body.pack_start(row, False, False, 0)

        note = Gtk.Label(label="A senha sera entregue diretamente ao NetworkManager, "
                               "sem passar por argumentos de comando ou ser enviada ao servidor da Enfoque.")
        note.set_xalign(0)
        note.set_line_wrap(True)
        body.pack_start(note, False, False, 0)

        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.rescan = Gtk.Button(label="Atualizar redes")
        self.rescan.connect("clicked", self.refresh)
        actions.pack_start(self.rescan, False, False, 0)
        self.keyboard = Gtk.Button(label="Teclado virtual")
        self.keyboard.connect("clicked", self.open_keyboard)
        actions.pack_start(self.keyboard, False, False, 0)
        self.connect_button = Gtk.Button(label="Conectar")
        self.connect_button.get_style_context().add_class("suggested-action")
        self.connect_button.connect("clicked", self.connect_network)
        actions.pack_end(self.connect_button, False, False, 0)
        body.pack_end(actions, False, False, 0)
        self.refresh()

    def message(self, text):
        dialog = Gtk.MessageDialog(self, 0, Gtk.MessageType.WARNING,
                                   Gtk.ButtonsType.OK, text)
        dialog.run()
        dialog.destroy()

    def set_busy(self, busy, message=None):
        self.busy = busy
        self.rescan.set_sensitive(not busy)
        self.connect_button.set_sensitive(not busy)
        if message:
            self.status.set_text(message)

    def network_selected(self, *_):
        hidden = self.hidden_toggle.get_active()
        self.ssid.set_visible(hidden)
        idx = self.network.get_active()
        if 0 <= idx < len(self.networks) and not hidden:
            security = self.networks[idx]["security"]
            self.password.set_sensitive(bool(security and security != "--"))
        else:
            self.password.set_sensitive(True)

    def open_keyboard(self, *_):
        try:
            subprocess.Popen(["/usr/bin/onboard"], stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
            self.set_keep_above(False)
        except OSError:
            self.message("Teclado virtual nao disponivel. Verifique o pacote onboard.")

    def refresh(self, *_):
        if self.busy:
            return
        self.set_busy(True, "Procurando redes Wi-Fi...")
        threading.Thread(target=self.scan_worker, daemon=True).start()

    def scan_worker(self):
        try:
            dev = run_nmcli(["--terse", "--escape", "yes", "--fields",
                             "DEVICE,TYPE,STATE", "device", "status"], timeout=9)
            radio = run_nmcli(["--terse", "--fields", "WIFI-HW,WIFI",
                               "radio", "all"], timeout=9)
            hardware = software = True
            if radio.returncode == 0:
                vals = radio.stdout.strip().split(":")
                if len(vals) >= 2:
                    hardware, software = (x == "enabled" for x in vals[:2])
            adapter = has_wifi_device(dev.stdout) if dev.returncode == 0 else False
            if not adapter:
                GLib.idle_add(self.scan_ready, [], diagnose(False, software, hardware, True))
                return
            if not software or not hardware:
                GLib.idle_add(self.scan_ready, [], diagnose(True, software, hardware, True))
                return
            if not (Path("/usr/sbin/wpa_supplicant").is_file() or
                    Path("/sbin/wpa_supplicant").is_file() or
                    shutil.which("wpa_supplicant")):
                GLib.idle_add(self.scan_ready, [], diagnose(True, True, True, False))
                return
            scan = run_nmcli(["--terse", "--escape", "yes", "--fields",
                              "SSID,SECURITY,SIGNAL", "device", "wifi",
                              "list", "--rescan", "yes"], timeout=28)
            if scan.returncode:
                GLib.idle_add(self.scan_ready, [], "Falha ao procurar redes. Verifique firmware e adaptador.")
                return
            networks = parse_access_points(scan.stdout)
            message = f"{len(networks)} rede(s) encontrada(s)." if networks else (
                "Nenhuma rede visivel. Tente atualizar ou informe um SSID oculto.")
            GLib.idle_add(self.scan_ready, networks, message)
        except (OSError, subprocess.SubprocessError):
            GLib.idle_add(self.scan_ready, [], "Nao foi possivel consultar o NetworkManager.")

    def scan_ready(self, networks, message):
        self.networks = networks
        self.network.remove_all()
        for network in networks:
            security = network["security"]
            summary = (security if security and security != "--" else "aberta")
            self.network.append_text(f'{network["ssid"]}  |  {network["signal"]}%  |  {summary}')
        if networks:
            self.network.set_active(0)
        self.set_busy(False, message)
        self.network_selected()
        return False

    def connect_network(self, *_):
        if self.busy:
            return
        hidden = self.hidden_toggle.get_active()
        idx = self.network.get_active()
        ssid = self.ssid.get_text().strip() if hidden else (
            self.networks[idx]["ssid"] if 0 <= idx < len(self.networks) else "")
        try:
            args = build_connect_argv(ssid, hidden)
        except ValueError:
            self.message("Selecione uma rede ou informe um SSID valido.")
            return
        selected_sec = self.networks[idx]["security"] if not hidden and 0 <= idx < len(self.networks) else ""
        password = self.password.get_text()
        if selected_sec and selected_sec != "--" and not password:
            self.message("Informe a senha Wi-Fi, ou use a configuracao avancada da rede.")
            return
        # The secret is passed only via stdin; never through argv or stdout.
        self.set_busy(True, f"Conectando a {ssid}...")
        threading.Thread(target=self.connect_worker, args=(args, password), daemon=True).start()

    def connect_worker(self, args, password):
        try:
            result = run_nmcli(args, timeout=60, input_text=password + "\n" if password else "")
            success = result.returncode == 0
        except (OSError, subprocess.SubprocessError):
            success = False
        GLib.idle_add(self.connect_done, success)

    def connect_done(self, success):
        self.password.set_text("")
        self.set_busy(False, "Wi-Fi conectado com sucesso!" if success
                      else "Nao foi possivel conectar. Verifique a senha, o sinal e a rede.")
        if success:
            self.message("Rede Wi-Fi conectada. Pode voltar ao instalador.")
        return False


if __name__ == "__main__":
    window = WifiSetup()
    window.show_all()
    window.network_selected()
    Gtk.main()
