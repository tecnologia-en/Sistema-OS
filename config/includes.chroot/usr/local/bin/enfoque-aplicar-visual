#!/bin/sh
# Personalizacao da sessao XFCE: visual estilo Windows sem componentes proprietarios.
set -eu
WALLPAPER=/usr/share/backgrounds/enfoque-os/wallpaper.jpg
MARKER="${HOME}/.cache/enfoque-os-visual-v0210"
if [ ! -f "$WALLPAPER" ] || ! command -v xfconf-query >/dev/null 2>&1; then
  exit 0
fi
[ -f "$MARKER" ] && exit 0
set_xfconf() {
  channel="$1"; key="$2"; type="$3"; value="$4"
  if xfconf-query -c "$channel" -p "$key" >/dev/null 2>&1; then
    xfconf-query -c "$channel" -p "$key" -s "$value" >/dev/null 2>&1 || true
  else
    xfconf-query -c "$channel" -p "$key" -n -t "$type" -s "$value" >/dev/null 2>&1 || true
  fi
}
sleep 2
set_xfconf xsettings /Net/ThemeName string Arc
set_xfconf xsettings /Net/IconThemeName string Papirus
set_xfconf xfwm4 /general/theme string Arc
set_xfconf xfwm4 /general/title_alignment string left
set_xfconf xfce4-desktop /desktop-icons/style int 2
set_xfconf xfce4-desktop /desktop-icons/icon-size int 48
# The recycle bin is a virtual XFCE icon. Keep business shortcuts on disk.
set_xfconf xfce4-desktop /desktop-icons/file-icons/show-trash bool true
for icon in home filesystem removable device-fixed device-removable network-removable unknown-removable; do
  set_xfconf xfce4-desktop "/desktop-icons/file-icons/show-$icon" bool false
done

# No modo Live a barra deve ocupar toda a borda inferior, sem auto-ocultar.
# Respeite personalizacoes de equipamentos instalados fora do modo Live.
if [ -d /run/live/medium ]; then
  set_xfconf xfce4-panel /panels/panel-1/position string "p=10;x=0;y=0"
  set_xfconf xfce4-panel /panels/panel-1/length uint 100
  set_xfconf xfce4-panel /panels/panel-1/autohide-behavior uint 0
  set_xfconf xfce4-panel /panels/panel-1/position-locked bool true
fi


# Respeita a pasta de area de trabalho traduzida pelo xdg-user-dirs.
DESKTOP="${HOME}/Desktop"
if command -v xdg-user-dir >/dev/null 2>&1; then
  configured="$(xdg-user-dir DESKTOP 2>/dev/null || true)"
  [ -z "$configured" ] || DESKTOP="$configured"
fi
mkdir -p "$DESKTOP"
# Remove only official, known legacy launchers. Never purge arbitrary files
# from an existing employee's Desktop: documents and personal shortcuts are
# preserved; the new ISO ships exactly two Desktop launchers.
remove_os_shortcut() {
  file="$1"; expected_exec="$2"
  if [ -f "$DESKTOP/$file" ] && grep -Fxq "Exec=$expected_exec" "$DESKTOP/$file"; then
    rm -f -- "$DESKTOP/$file"
  fi
}
remove_os_shortcut 'Compatibilidade-Windows.desktop' 'enfoque-paygo configurar'
remove_os_shortcut 'PayGo.desktop' 'enfoque-paygo abrir'
remove_os_shortcut 'Enfoque-Central.desktop' 'enfoque-central'
remove_os_shortcut 'Instalar-Enfoque-OS.desktop' '/usr/local/bin/enfoque-instalar'
# Calamares adds a second, generic desktop launcher on Live systems.
# Installation remains available through the application menu.
if [ -d /run/live/medium ]; then
  remove_os_shortcut 'calamares-install-debian.desktop' 'calamares-install-debian'
fi
for item in SIGE.desktop Intranet.desktop; do
  if [ -f "/etc/skel/Desktop/$item" ]; then
    [ -e "$DESKTOP/$item" ] || cp "/etc/skel/Desktop/$item" "$DESKTOP/$item"
    chmod u+x "$DESKTOP/$item"
  fi
done

props=''
i=0
while [ "$i" -lt 5 ]; do
  props="$(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep -E '^/backdrop/screen[0-9]+/monitor[^/]+/workspace[0-9]+/last-image$' || true)"
  [ -n "$props" ] && break
  i=$((i+1))
  sleep 1
done
if [ -z "$props" ]; then
  props='/backdrop/screen0/monitor0/workspace0/last-image
/backdrop/screen0/monitorVirtual1/workspace0/last-image'
fi
printf '%s\n' "$props" | while IFS= read -r prop; do
  [ -n "$prop" ] || continue
  set_xfconf xfce4-desktop "$prop" string "$WALLPAPER"
  set_xfconf xfce4-desktop "${prop%/last-image}/image-style" int 5
done
xfdesktop --reload >/dev/null 2>&1 || true
mkdir -p "${HOME}/.cache"
: > "$MARKER"
