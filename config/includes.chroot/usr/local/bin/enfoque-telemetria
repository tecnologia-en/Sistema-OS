#!/usr/bin/env python3
"""Telemetria Enfoque OS: somente CPU/RAM, sem controle remoto e sem credenciais embutidas."""
import json
import os
import platform
import signal
import socket
import ssl
import sys
import threading
import time
import urllib.error
import urllib.request

CONFIG = "/etc/enfoque-os/agent.json"
URL = "https://intranet.enfoquepapelaria.com.br/api/remote-access/agent/heartbeat"
INTERVAL = 30
stop = threading.Event()
signal.signal(signal.SIGTERM, lambda *_: stop.set())
signal.signal(signal.SIGINT, lambda *_: stop.set())


def cpu_sample():
    with open("/proc/stat", encoding="ascii") as stream:
        fields = list(map(int, stream.readline().split()[1:]))
    idle = fields[3] + (fields[4] if len(fields) > 4 else 0)
    return sum(fields), idle


def mem_usage():
    with open("/proc/meminfo", encoding="ascii") as stream:
        fields = {}
        for line in stream:
            label, value = line.split(":", 1)
            fields[label] = int(value.strip().split()[0])
    total = fields["MemTotal"] // 1024
    available = fields.get("MemAvailable", fields["MemFree"]) // 1024
    return max(0, total - available), total


def local_ip():
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as client:
            client.connect(("1.1.1.1", 53))
            return client.getsockname()[0]
    except OSError:
        return ""


def read_identity():
    status = os.stat(CONFIG)
    if status.st_uid != 0 or status.st_mode & 0o077:
        raise ValueError("Config do agente precisa pertencer ao root e ter chmod 600.")
    with open(CONFIG, encoding="utf-8") as stream:
        data = json.load(stream)
    did, token = data.get("id", ""), data.get("token", "")
    if not isinstance(did, str) or not isinstance(token, str) or len(did) != 36 or len(token) < 35:
        raise ValueError("Identidade do computador incompleta.")
    return did, token


def os_release_version():
    try:
        with open("/etc/enfoque-os-release", encoding="utf-8") as file:
            for raw in file:
                if raw.startswith("VERSION="):
                    return raw.partition("=")[2].strip().strip('"')[:20]
    except OSError:
        pass
    return "piloto"


def send_heartbeat(did, token):
    used, total = mem_usage()
    before = cpu_sample()
    stop.wait(0.4)
    after = cpu_sample()
    dt, di = after[0] - before[0], after[1] - before[1]
    cpu = round(100 * max(0, dt - di) / dt, 1) if dt > 0 else 0
    with open("/proc/uptime", encoding="ascii") as stream:
        uptime = max(0, int(float(stream.read().split()[0])))
    payload = {
        "cpuPct": cpu, "ramUsedMb": used, "ramTotalMb": total,
        "uptimeSeconds": uptime, "os": "Enfoque OS " + os_release_version(),
        "agentVersion": "0.1.7", "ip": local_ip()
    }
    request = urllib.request.Request(URL, data=json.dumps(payload).encode("utf-8"), method="POST",
        headers={"Content-Type": "application/json", "X-Enfoque-Device-Id": did,
                 "X-Enfoque-Device-Token": token})
    with urllib.request.urlopen(request, timeout=8, context=ssl.create_default_context()) as response:
        if response.status != 204:
            raise RuntimeError("Servidor recusou telemetria: HTTP " + str(response.status))


def main():
    try:
        device_id, token = read_identity()
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        print("Enfoque OS sem pareamento válido:", str(exc), file=sys.stderr)
        return 1
    while not stop.is_set():
        try:
            send_heartbeat(device_id, token)
        except (OSError, urllib.error.URLError, RuntimeError) as exc:
            print("Falha de telemetria; será tentado novamente:", type(exc).__name__, file=sys.stderr)
        stop.wait(INTERVAL)
    return 0


if __name__ == "__main__":
    sys.exit(main())
