#!/bin/sh
# Launch within the interactive XFCE/XDG startup session, not a background
# systemd --user job: Xfwm can otherwise leave the fullscreen setup behind
# other autostart windows. Enrollment remains root-validated and one-time.
set -eu
[ ! -d /run/live/medium ] || exit 0
[ ! -e /var/lib/enfoque-os/firstboot.json ] || exit 0
exec /usr/local/bin/enfoque-primeiro-acesso
