#!/bin/sh
# Enfoque OS 0.2.43: visual de bloqueio aos 3 min, senha nativa aos 15.
# Reaplica a politica ao entrar na sessao e apos upgrade, sem reiniciar o PC.
# Autenticacao e captura de teclado continuam exclusivamente no xfce4-screensaver.
# Live nao recebe bloqueio para nao interromper instalacao e backup.
set -eu
[ -n "${DISPLAY:-}" ] || exit 0
command -v xfconf-query >/dev/null 2>&1 || exit 0
command -v xfce4-screensaver >/dev/null 2>&1 || exit 0

marker="${HOME}/.config/enfoque-os/tela-043-configurada"
# Marcador e somente registro, nao bloqueia reconfiguracao de versoes futuras.

set_value() {
    channel="$1"
    key="$2"
    type="$3"
    value="$4"
    if xfconf-query -c "$channel" -p "$key" >/dev/null 2>&1; then
        xfconf-query -c "$channel" -p "$key" -s "$value"
    else
        xfconf-query -c "$channel" -p "$key" -n -t "$type" -s "$value"
    fi
}

# O XFCE nativo controla o desbloqueio seguro e os tempos.
if [ -e /run/live/medium ]; then
    set_value xfce4-screensaver /saver/enabled bool false
    set_value xfce4-screensaver /saver/idle-activation/enabled bool false
    set_value xfce4-screensaver /lock/enabled bool false
    if command -v xfce4-screensaver-command >/dev/null 2>&1; then
        xfce4-screensaver-command --exit >/dev/null 2>&1 || true
    fi
    exit 0
fi

[ -x /usr/local/bin/enfoque-papel-parede-ocioso ] || exit 1
[ -x /usr/local/bin/enfoque-tela-de-bloqueio ] || exit 1
[ -r /usr/share/applications/screensavers/enfoque-wallpaper-dim.desktop ] || exit 1

set_value xfce4-screensaver /saver/enabled bool true
# 0 = tela em branco, 1 = temas aleatorios, 2 = tema unico.
set_value xfce4-screensaver /saver/mode int 2
if xfconf-query -c xfce4-screensaver -p /saver/themes/list >/dev/null 2>&1; then
    xfconf-query -c xfce4-screensaver -p /saver/themes/list \
        -a -t string -s enfoque-wallpaper-dim
else
    xfconf-query -c xfce4-screensaver -p /saver/themes/list \
        -n -a -t string -s enfoque-wallpaper-dim
fi
set_value xfce4-screensaver /saver/idle-activation/enabled bool true
set_value xfce4-screensaver /saver/idle-activation/delay int 3
set_value xfce4-screensaver /saver/fullscreen-inhibit bool false
set_value xfce4-screensaver /lock/enabled bool true
set_value xfce4-screensaver /lock/saver-activation/enabled bool true
# 12 minutos depois do descanso (3 + 12 = 15).
set_value xfce4-screensaver /lock/saver-activation/delay int 12
set_value xfce4-screensaver /lock/sleep-activation bool true

# Evita que X11/xfce4-power-manager substituam o descanso por tela preta
# ou desliguem o monitor, na tomada ou bateria. Sono manual nao e alterado.
set_value xfce4-power-manager /xfce4-power-manager/dpms-enabled bool false
set_value xfce4-power-manager /xfce4-power-manager/blank-on-ac int 0
set_value xfce4-power-manager /xfce4-power-manager/blank-on-battery int 0
if command -v xset >/dev/null 2>&1; then
    xset s off >/dev/null 2>&1 || true
    xset s noblank >/dev/null 2>&1 || true
    xset -dpms >/dev/null 2>&1 || true
fi

if command -v xfce4-screensaver-command >/dev/null 2>&1; then
    if ! xfce4-screensaver-command --query >/dev/null 2>&1; then
        (xfce4-screensaver >/dev/null 2>&1 &)
    fi
fi

umask 077
mkdir -p "${HOME}/.config/enfoque-os"
printf 'Politica 0.2.43: tela de bloqueio 3 min; senha 15 min.\n' > "$marker"
