#!/usr/bin/env python3
"""Fail closed on corrupt PayGo data; do not overwrite financial transaction data."""
from contextlib import closing
import os
from pathlib import Path
import stat
import sqlite3
import sys

BASE = Path("/var/lib/paygo-tef")
PREFIX = BASE / "runtime"
DATABASE = PREFIX / "drive_c/ProgramData/PayGo/Data/PayGo.db"
PINPAD = PREFIX / "dosdevices/com8"
SYS_TTY = Path("/sys/class/tty")
DEV_DIR = Path("/dev")
GERTEC_USB_ID = ("1753", "c902")
WRITE_DIRS = (
    "drive_c/ProgramData/PayGo/Data",
    "drive_c/ProgramData/PayGo/Log",
    "drive_c/ProgramData/PayGo/PGWebLib/Data",
    "drive_c/ProgramData/PayGo/PGWebLib/Log",
)
def validate_pinpad_alias(pinpad=PINPAD, sys_tty=SYS_TTY, dev_dir=DEV_DIR):
    """Only a GERTEC PPC930 ACM char-device may serve Wine COM8.

    This checks identity, not just path existence. Tests inject temporary
    paths; production always uses /sys/class/tty and /dev.
    """
    if not pinpad.is_symlink():
        raise RuntimeError("COM8 ausente ou nao e um alias serial")
    try:
        device = pinpad.resolve(strict=True)
    except (OSError, RuntimeError) as exc:
        raise RuntimeError("COM8 aponta para dispositivo ausente") from exc
    if device.parent != dev_dir.resolve() or not device.name.startswith("ttyACM"):
        raise RuntimeError("COM8 aponta para porta USB/ACM inesperada")
    if not stat.S_ISCHR(device.stat().st_mode):
        raise RuntimeError("COM8 nao aponta para dispositivo serial real")
    if not os.access(device, os.R_OK | os.W_OK):
        raise RuntimeError("Conta TEF sem acesso de leitura/escrita ao PIN-pad")
    # The tty's symlink leads to the USB interface. Parent holds the USB
    # device's idVendor/idProduct; avoids matching other ttyACM devices.
    interface = (sys_tty / device.name / "device").resolve(strict=True)
    usb = interface.parent
    try:
        vendor = (usb / "idVendor").read_text(encoding="ascii").strip().lower()
        product = (usb / "idProduct").read_text(encoding="ascii").strip().lower()
    except OSError as exc:
        raise RuntimeError("Identidade USB do PIN-pad indisponivel") from exc
    if (vendor, product) != GERTEC_USB_ID:
        raise RuntimeError("COM8 nao pertence ao GERTEC PPC930 esperado")
    return device


def check():
    if not (BASE / "provisioned").is_file():
        raise RuntimeError("TEF nao provisionado")
    if not DATABASE.is_file():
        raise RuntimeError("Banco TEF ausente")
    with closing(sqlite3.connect(f"file:{DATABASE}?mode=ro", uri=True, timeout=5)) as db:
        if db.execute("PRAGMA quick_check").fetchone()[0] != "ok":
            raise RuntimeError("Banco TEF nao passou na verificacao de integridade")
        row = db.execute("SELECT TER_Id,TER_TERF_Id FROM PAY_Terminal LIMIT 1").fetchone()
        if not row or not all(row):
            raise RuntimeError("Terminal TEF nao configurado")
    for directory in WRITE_DIRS:
        p = PREFIX / directory
        if not p.is_dir() or not os.access(p, os.R_OK | os.W_OK | os.X_OK):
            raise RuntimeError("Diretorio TEF sem escrita: " + directory)
    validate_pinpad_alias()
    if not (PREFIX / "drive_c/Program Files/PayGo/PayGo.exe").is_file():
        raise RuntimeError("Executavel PayGo ausente")
    return row

def main():
    try:
        terminal = check()
        if "--quiet" not in sys.argv:
            print(f"TEF integro; terminal {terminal[0]}; nenhum dado de pagamento exibido")
        return 0
    except (OSError, sqlite3.Error, RuntimeError) as error:
        print("Falha na integridade do TEF: " + str(error), file=sys.stderr)
        return 1

if __name__ == "__main__":
    sys.exit(main())
