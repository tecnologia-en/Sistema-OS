#!/usr/bin/env python3
"""Enfoque Centro, Bematech MP-4200 / 80 mm: fit Chrome receipt PDFs in CUPS.
Only active for the explicitly patched Bematech queue. The native vendor filter
and USB/serial backend remain unchanged. No network or customer data export.
"""
import math
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

VENDOR = "/usr/lib/cups/filter/bemafilters.sh"
MAX_BYTES = 24 * 1024 * 1024
MAX_PAGES = 12
SIDE_PT = 5.0        # ~1.8 mm, inside the physical 72 mm printable width
TOP_PT = 5.0         # ~1.8 mm
BOTTOM_PT = 10.0     # ~3.5 mm, sufficient for cutter clearance

def run(argv, timeout=35):
    return subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                          timeout=timeout, check=True)

def count_pages_and_sizes(path):
    info = run(["/usr/bin/pdfinfo", "-box", "-f", "1", "-l", "100", str(path)], 12).stdout.decode("latin1", "replace")
    num = re.search(r"^Pages:\s+(\d+)\s*$", info, re.M)
    if num is None:
        return None
    pages = int(num.group(1))
    if not 1 <= pages <= MAX_PAGES:
        return None
    pairs = re.findall(r"^Page\s+(\d+) size:\s+([0-9.]+) x ([0-9.]+) pts", info, re.M)
    sizes = {int(i): (float(w), float(h)) for i, w, h in pairs}
    rots = re.findall(r"^Page\s+(\d+) rot:\s+(\d+)", info, re.M)
    if len(sizes) != pages or any(int(v) % 360 for _, v in rots):
        return None
    return [sizes.get(i) for i in range(1, pages + 1)]

def ink_bounds(path, page_count):
    output = run(["/usr/bin/gs", "-q", "-dBATCH", "-dNOPAUSE", "-dSAFER",
                  "-sDEVICE=bbox", str(path)], 45).stderr.decode("latin1", "replace")
    pairs = re.findall(r"^%%HiResBoundingBox:\s+(-?[\d.]+)\s+(-?[\d.]+)\s+(-?[\d.]+)\s+(-?[\d.]+)", output, re.M)
    if len(pairs) != page_count:
        return None
    return [tuple(map(float, p)) for p in pairs]

def transform(path, directory):
    page_sizes = count_pages_and_sizes(path)
    if not page_sizes or any(d is None for d in page_sizes):
        return None
    bounds = ink_bounds(path, len(page_sizes))
    if not bounds:
        return None
    targets = []
    for i, ((width, height), (xmin, ymin, xmax, ymax)) in enumerate(zip(page_sizes, bounds), 1):
        ink_w, ink_h = xmax - xmin, ymax - ymin
        # Do not reinterpret A4/labels or malformed/empty PDF files.
        if not (185 <= width <= 236 and 180 <= height <= 1500 and
                25 < ink_w <= width + 2 and 12 < ink_h <= height + 2 and
                -4 <= xmin < xmax <= width + 4 and -4 <= ymin < ymax <= height + 4):
            return None
        fit_scale = min(1.40, (width - 2 * SIDE_PT) / ink_w,
                        (height - TOP_PT - BOTTOM_PT) / ink_h)
        if fit_scale <= 0 or fit_scale > 1.5:
            return None
        out_height = int(math.ceil(ink_h * fit_scale + TOP_PT + BOTTOM_PT))
        if not (30 <= out_height <= int(height) + 1):
            return None
        offset_x = -xmin + SIDE_PT / fit_scale
        offset_y = -ymin + BOTTOM_PT / fit_scale
        in_page = path
        if len(page_sizes) > 1:
            in_page = Path(directory) / ("page_%02d.pdf" % i)
            run(["/usr/bin/pdfseparate", "-f", str(i), "-l", str(i),
                 str(path), str(in_page)], 20)
        out_page = Path(directory) / ("fitted_%02d.pdf" % i)
        begin_page = ("<</BeginPage {pop %.8f %.8f scale %.8f %.8f translate}>> setpagedevice"
                      % (fit_scale, fit_scale, offset_x, offset_y))
        run(["/usr/bin/gs", "-q", "-dBATCH", "-dNOPAUSE", "-dSAFER",
             "-sDEVICE=pdfwrite", "-dFIXEDMEDIA",
             "-dDEVICEWIDTHPOINTS=%d" % int(round(width)),
             "-dDEVICEHEIGHTPOINTS=%d" % out_height,
             "-sOutputFile=" + str(out_page),
             "-c", begin_page, "-f", str(in_page)], 35)
        targets.append(out_page)
        print("INFO: Enfoque thermal fit page=%d source_width_pt=%.1f ink_width_pt=%.1f scale=%.3f final_height_pt=%d" %
              (i, width, ink_w, fit_scale, out_height), file=sys.stderr)
    if len(targets) == 1:
        return targets[0]
    final = Path(directory) / "receipt_fitted.pdf"
    run(["/usr/bin/pdfunite", *map(str, targets), str(final)], 40)
    return final

def main():
    if len(sys.argv) >= 2 and sys.argv[1] == "--preflight":
        if len(sys.argv) != 4:
            return 2
        with tempfile.TemporaryDirectory(prefix="enfoque-bema-test-") as tmp:
            fitted = transform(Path(sys.argv[2]), tmp)
            if not fitted:
                print("preflight refused: incompatible PDF", file=sys.stderr)
                return 1
            shutil.copyfile(fitted, sys.argv[3])
            return 0
    if len(sys.argv) not in (6, 7):
        print("ERROR: invalid Bematech CUPS filter arguments", file=sys.stderr)
        return 2
    if not Path(VENDOR).is_file() or not os.access(VENDOR, os.X_OK):
        print("ERROR: native Bematech filter is unavailable", file=sys.stderr)
        return 2
    with tempfile.TemporaryDirectory(prefix="enfoque-bema-") as tmp:
        if len(sys.argv) == 7:
            original = Path(sys.argv[6])
        else:
            original = Path(tmp) / "original.bin"
            with original.open("wb") as out:
                while True:
                    data = sys.stdin.buffer.read(131072)
                    if not data:
                        break
                    out.write(data)
        fitted = None
        try:
            if original.stat().st_size <= MAX_BYTES:
                with original.open("rb") as f:
                    if f.read(5) == b"%PDF-":
                        fitted = transform(original, tmp)
        except (OSError, ValueError, subprocess.CalledProcessError, subprocess.TimeoutExpired) as exc:
            print("WARNING: Enfoque thermal fit unavailable; using unchanged vendor filter: %s" %
                  type(exc).__name__, file=sys.stderr)
        # Delegation preserves the manufacturer's rasterization, cutter and drawer settings.
        args = [VENDOR, *sys.argv[1:6], str(fitted or original)]
        return subprocess.run(args).returncode

if __name__ == "__main__":
    sys.exit(main())
