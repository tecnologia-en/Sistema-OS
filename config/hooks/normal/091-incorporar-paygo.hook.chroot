#!/bin/sh
# Baixa o instalador oficial Windows no build da ISO, sem ativar o terminal.
set -eu
export DEBIAN_FRONTEND=noninteractive
apt-get install -y --no-install-recommends unzip
url='https://setis.com.br/filevista/public/gaz4/paygodev-pgwindocintegracao/20260923-integracao-setuppaygo-v5-1-50-924.zip'
tmp=/tmp/enfoque-paygo-oficial.zip
dest=/opt/enfoque/paygo
mkdir -p "$dest"
curl --fail --silent --show-error --location --retry 3 --connect-timeout 30 --max-time 900 --max-filesize 800000000 "$url" --output "$tmp"
test -s "$tmp"
unzip -tqq "$tmp"
entry="$(unzip -Z1 "$tmp" | grep -Ei '(^|/)SetupPayGo_full_v[^/]*[.]exe$' | head -n 1 || true)"
if [ -z "$entry" ]; then
  echo 'ERRO: pacote nao possui o instalador PayGo documentado.' >&2
  exit 1
fi
unzip -p "$tmp" "$entry" > "$dest/SetupPayGo.exe"
test -s "$dest/SetupPayGo.exe"
magic="$(od -An -tx1 -N2 "$dest/SetupPayGo.exe" | tr -d ' \n')"
test "$magic" = '4d5a' || { echo 'ERRO: instalador nao e executavel Windows.' >&2; exit 1; }
chmod 0644 "$dest/SetupPayGo.exe"
(cd "$dest" && sha256sum SetupPayGo.exe > SHA256SUMS)
printf '%s\n' 'Pacote oficial PayGo Windows 5.1.50.24' 'Origem: documentacao PayGo Dev' 'Nao ativado nem homologado para Linux' > "$dest/ORIGEM.txt"
rm -f "$tmp"
echo 'Instalador oficial PayGo embutido na ISO.'
