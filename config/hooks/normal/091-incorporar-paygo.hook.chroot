#!/bin/sh
# Incorpora instalador autentico PayGo Windows na ISO; NAO executa em build.
set -eu
url='https://setis.com.br/filevista/public/gaz4/paygodev-pgwindocintegracao/20260923-integracao-setuppaygo-v5-1-50-924.zip'
zip_hash='6b90e797b928eef815c6463cf657c1b3d22b331e387e478a3f71dfbc0c207a39'
exe_hash='bccab187ff5ac25ad1e5351d584193aeb1a6f2ce467f783c5305f98d6b2d0531'
archive=/tmp/enfoque-paygo-oficial.zip
dest=/opt/enfoque/paygo
mkdir -p "$dest"
curl --fail --silent --show-error --location --retry 3 --connect-timeout 30 --max-time 900 --max-filesize 800000000 "$url" --output "$archive"
printf '%s  %s\n' "$zip_hash" "$archive" | sha256sum -c -
unzip -tqq "$archive"
entry="$(unzip -Z1 "$archive" | grep -Ei '(^|/)SetupPayGo_full_v[^/]*[.]exe$' | head -n 1 || true)"
if [ -z "$entry" ]; then
  echo 'Erro: instalador PayGo nao localizado no pacote verificado.' >&2
  exit 1
fi
unzip -p "$archive" "$entry" > "$dest/SetupPayGo.exe"
printf '%s  %s\n' "$exe_hash" "$dest/SetupPayGo.exe" | sha256sum -c -
magic="$(od -An -tx1 -N2 "$dest/SetupPayGo.exe" | tr -d ' \n')"
[ "$magic" = '4d5a' ] || { echo 'Erro: instalador nao e PE (MZ).' >&2; exit 1; }
chmod 0644 "$dest/SetupPayGo.exe"
(cd "$dest" && sha256sum SetupPayGo.exe > SHA256SUMS)
printf '%s\n' 'PayGo Windows 5.1.50.924; fonte: SETIS' 'Somente piloto; Windows em Linux nao homologado' > "$dest/ORIGEM.txt"
rm -f "$archive"
echo 'PayGo: instalador oficial verificado e incorporado a imagem.'
