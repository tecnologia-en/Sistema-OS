#!/bin/sh
# SetupPayGo oficial e PE32: evitar prefixo misto WoW64 no Debian 13.
set -eu
export DEBIAN_FRONTEND=noninteractive
dpkg --add-architecture i386
apt-get update
apt-get install -y --no-install-recommends wine wine32:i386 libwine:i386 fonts-wine zenity unzip
dpkg-query -W wine wine32:i386 libwine:i386
test -x /usr/lib/wine/wine
