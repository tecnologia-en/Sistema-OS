#!/bin/sh
# Enfoque OS: drivers genericos, notificacoes e impressao IPP em primeira inicializacao instalada.
set -eu
chmod 755 /usr/local/sbin/enfoque-hardware-setup /usr/local/bin/enfoque-desktop-shell /usr/local/bin/enfoque-super-key
chmod 755 /usr/local/bin/enfoque-relogio-painel /usr/local/bin/enfoque-notificacoes-painel /usr/local/bin/enfoque-impressoras-painel
systemctl enable enfoque-hardware-inicial.timer >/dev/null
# Automatic network + IPP-over-USB driverless detection by cups-browsed (when present).
# Change only a recognized settings key, avoiding duplicates.
conf=/etc/cups/cups-browsed.conf
if [ -f "$conf" ]; then
  if grep -Eq '^CreateIPPPrinterQueues[[:space:]]' "$conf"; then
    sed -i 's/^CreateIPPPrinterQueues[[:space:]].*/CreateIPPPrinterQueues Driverless/' "$conf"
  else
    printf '\n# Enfoque OS driverless\nCreateIPPPrinterQueues Driverless\n' >> "$conf"
  fi
fi
