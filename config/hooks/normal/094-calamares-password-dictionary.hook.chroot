#!/bin/sh
# Calamares password validation uses cracklib. CI must fail if the
# Brazilian dictionary was not built into the image by apt/dpkg hooks.
set -eu
command -v update-cracklib >/dev/null
test -r /usr/share/dict/words
update-cracklib
test -s /var/cache/cracklib/cracklib_dict.hwm
test -s /var/cache/cracklib/cracklib_dict.pwd
test -s /var/cache/cracklib/cracklib_dict.pwi
echo "Enfoque OS: cracklib dictionary ready for Calamares"
