# Force POSIX text line endings in Linux image files even when edited on Windows.
*.sh text eol=lf
*.hook.chroot text eol=lf
*.desktop text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.cfg text eol=lf
*.plymouth text eol=lf
*.script text eol=lf
*.py text eol=lf
*.list.chroot text eol=lf
*.list.binary text eol=lf
config/includes.chroot/usr/local/bin/* text eol=lf
config/includes.chroot/usr/local/sbin/* text eol=lf
config/includes.chroot/etc/default/* text eol=lf
config/includes.chroot/etc/apt/apt.conf.d/* text eol=lf
config/includes.chroot/etc/logrotate.d/* text eol=lf
config/includes.chroot/etc/enfoque-os-release text eol=lf
*.list text eol=lf
