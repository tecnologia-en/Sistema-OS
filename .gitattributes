# Force POSIX text line endings in Linux image files even when edited on Windows.
*.sh text eol=lf
*.hook.chroot text eol=lf
*.desktop text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.cfg text eol=lf
*.plymouth text eol=lf
*.script text eol=lf
*.py text eol=lf
*.list.chroot text eol=lf
*.list.binary text eol=lf
config/includes.chroot/usr/local/bin/* text eol=lf
config/includes.chroot/usr/local/sbin/* text eol=lf
config/includes.chroot/etc/default/* text eol=lf
config/includes.chroot/etc/apt/apt.conf.d/* text eol=lf
config/includes.chroot/etc/logrotate.d/* text eol=lf
config/includes.chroot/etc/enfoque-os-release text eol=lf
*.list text eol=lf

# Patch files contain indentation of original C++ source in diff contexts.
patches/*.patch -whitespace

# N960K payload is copied byte-for-byte from the signed 1.0.1 APT package.
# No CRLF normalization or automatic whitespace fixes of validated TEF code.
config/includes.chroot/usr/share/enfoque-monitora/n960k-tef-inativa/** -text whitespace=-blank-at-eol,-blank-at-eof
config/includes.chroot/usr/local/lib/enfoque-n960k/** -text whitespace=-blank-at-eol,-blank-at-eof
